---
import { ClientRouter } from 'astro:transitions';
import StatusBar from '../components/StatusBar.astro';
import Toast from '../components/Toast.astro';
import Coffee from '../components/Coffee.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Extra Google Fonts `family=` params for this page. */
  fonts?: string;
  /** Colour the desk leans toward while this page is open. */
  tint?: string;
  /** Status-bar text colour inside the phone. */
  statusInk?: string;
  /** Share image under public/, e.g. /og/tally.png. */
  ogImage?: string;
}

const { title, description, fonts, tint, statusInk, ogImage = '/og/home.png' } = Astro.props;
const fontHref =
  'https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600;700&family=Space+Mono:wght@400;700' +
  (fonts ? `&${fonts}` : '') +
  '&display=fallback';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#d9d1c1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} />
    <script is:inline>
      // Runs before paint and after every client-side page swap.
      (function () {
        function istHour() {
          return Number(
            new Intl.DateTimeFormat('en-GB', { hour: 'numeric', hourCycle: 'h23', timeZone: 'Asia/Kolkata' }).format(new Date()),
          );
        }
        function apply() {
          var root = document.documentElement;
          var h = istHour();
          var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          root.dataset.time = dark || h < 6 || h >= 19 ? 'night' : 'day';
          var z = innerWidth < 768 ? 1 : Math.min(1, (innerHeight - 56) / 866);
          root.style.setProperty('--z', z.toFixed(4));
        }
        // Open (home → an app with an icon) or close (app → home) picks the animation in global.css.
        // Only the icon being opened (or closed back into) is named "app", the same name
        // AppShell gives the open app, so exactly one thing morphs in every browser.
        var vt = '';
        var from = '';
        function setVt() {
          if (vt) document.documentElement.dataset.vt = vt;
          else delete document.documentElement.dataset.vt;
        }
        // The exact icon that was tapped (the same app can sit on page two and in the dock),
        // and so which home page to come back to when it closes.
        var tapped = { path: '', index: -1 };
        function apps() {
          return Array.prototype.slice.call(document.querySelectorAll('[data-app]'));
        }
        function iconFor(path, preferIndex) {
          var list = apps();
          var el = list[preferIndex];
          if (!el || el.getAttribute('href') !== path) el = document.querySelector('[data-app][href="' + path + '"]');
          return el;
        }
        function nameIcon(el) {
          var icon = el && el.querySelector('.ic');
          if (icon) icon.style.viewTransitionName = 'app';
          return !!icon;
        }
        document.addEventListener('astro:before-preparation', function (e) {
          from = location.pathname;
          var to = e.to.pathname;
          if (from === '/') {
            var src = e.sourceElement && e.sourceElement.closest && e.sourceElement.closest('[data-app]');
            tapped = { path: to, index: src ? apps().indexOf(src) : -1 };
            vt = nameIcon(src || iconFor(to, -1)) ? 'open' : '';
          } else {
            vt = to === '/' ? 'close' : '';
          }
          setVt();
        });
        apply();
        addEventListener('resize', apply);
        document.addEventListener('astro:after-swap', function () {
          apply();
          if (vt === 'close') {
            var el = iconFor(from, tapped.path === from ? tapped.index : -1);
            // Bring that icon's home page back into view before the closing animation is drawn.
            var page = el && el.closest('.page');
            var pages = page && page.parentElement;
            if (pages) pages.scrollLeft = page.offsetLeft - pages.offsetLeft;
            if (!nameIcon(el)) vt = '';
          }
          setVt();
        });
        // Clear the name once the animation is over, so the next tap starts clean.
        document.addEventListener('astro:page-load', function () {
          setTimeout(function () {
            document.querySelectorAll('[data-app] .ic').forEach(function (el) {
              el.style.viewTransitionName = '';
            });
          }, 700);
        });
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="stage" style={tint ? `--tint:${tint}` : undefined}>
      <aside class="desk desk-l" aria-label="About">
        <slot name="left" />
        <Coffee />
      </aside>
      <div class="phone">
        <div class="screen" style={statusInk ? `--sb:${statusInk}` : undefined}>
          <StatusBar />
          <slot />
          <Toast />
        </div>
      </div>
      <aside class="desk desk-r" aria-label="Details">
        <slot name="right" />
      </aside>
    </div>
    <!-- Real time in every clock before the first paint, not a 9:41 placeholder. -->
    <script is:inline>window.__tick && window.__tick();</script>
    {
      import.meta.env.PROD && (
        <script is:inline>
          // Works offline after one visit (public/sw.js).
          if ('serviceWorker' in navigator) addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); });
        </script>
      )
    }
  </body>
</html>

<style is:global>
  .stage {
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(28px, 4vw, 80px);
    padding: 28px clamp(28px, 4vw, 72px);
    background: var(--desk);
    transition: background-color 0.5s ease;
    /* Things on the desk may run off its edge (the coffee does). */
    overflow: clip;
  }
  .stage[style*='--tint'] {
    background: color-mix(in oklab, var(--desk) 86%, var(--tint));
  }

  /* Separate layers for page changes: the screen (see global.css), and each side of the desk. */
  .screen {
    view-transition-name: screen;
  }
  .desk-l {
    view-transition-name: desk-l;
  }
  .desk-r {
    view-transition-name: desk-r;
  }

  .desk {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    min-width: 0;
    padding: 12px 0;
  }
  .desk-r {
    align-items: flex-end;
    text-align: right;
  }

  .phone {
    zoom: var(--z, 1);
    align-self: center;
    width: 412px;
    height: 866px;
    padding: 11px;
    border-radius: 62px;
    background: var(--bezel);
    flex: none;
  }
  .screen {
    position: relative;
    isolation: isolate;
    width: 390px;
    height: 844px;
    border-radius: 51px;
    overflow: hidden;
    background: var(--wall);
    color: var(--wall-ink);
  }

  /* Desktop: exactly one screen tall, so the phone stays centred; desk things may run off the edges. */
  @media (min-width: 1100px) {
    .stage {
      height: 100dvh;
    }
    .desk {
      min-height: 0;
    }
  }

  /* Tablet: phone first, notes below it. */
  @media (max-width: 1099px) {
    .stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 32px 24px 48px;
    }
    .phone {
      order: 1;
    }
    .desk-r {
      order: 2;
    }
    .desk-l {
      order: 3;
    }
    .desk,
    .desk-r {
      width: min(560px, 100%);
      align-items: stretch;
      text-align: left;
    }
  }

  /* Phone: no desk, no frame. The page is the home screen. */
  @media (max-width: 767px) {
    .stage {
      display: block;
      padding: 0;
    }
    .desk {
      display: none;
    }
    .phone {
      zoom: 1;
      width: 100%;
      height: 100dvh;
      padding: 0;
      border-radius: 0;
      background: none;
    }
    .screen {
      width: 100%;
      height: 100%;
      border-radius: 0;
    }
  }
</style>
