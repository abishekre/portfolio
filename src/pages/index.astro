---
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import DockIcon from '../components/DockIcon.astro';
import IndexCard from '../components/IndexCard.astro';
import DeskThings from '../components/DeskThings.astro';
import { allProjects, counts } from '../lib/projects';
import { SITE } from '../site';

const projects = await allProjects();
const c = counts(projects);
---

<Base title="Abishek R Edakkalathur" description={`${SITE.bio} Ten apps, from an SMS expense tracker to a 3D Bengaluru.`}>
  <Fragment slot="left">
    <IndexCard />
    <DeskThings thing="chai" />
  </Fragment>

  <main class="home">
    <header class="top">
      <div class="who">
        <p class="who-name">Abishek R Edakkalathur</p>
        <p class="who-bio">{SITE.bio}</p>
      </div>
      <a class="widget" href="/deuce" aria-label="Now building: Deuce">
        <span class="w-left">
          <span class="w-time" data-clock>9:41</span>
          <span class="w-place">{SITE.city} <span data-temp></span></span>
        </span>
        <span class="w-right">
          <span class="w-label">Now building</span>
          <span class="w-what">Deuce</span>
          <span class="w-sub">Google sign-in, then ratings</span>
        </span>
      </a>
    </header>

    <ul class="grid" data-grid>
      {
        projects.map((p) => (
          <li>
            <a class="app" href={`/${p.id}`} data-app>
              <AppIcon icon={p.data.icon} morph={`app-${p.id}`} />
              <span class="lbl">{p.data.label ?? p.data.name}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a class="app" href="/notes" data-app>
          <DockIcon kind="notes" morph="app-notes" />
          <span class="lbl">Notes</span>
        </a>
      </li>
    </ul>

    <a class="all" href="/list">All projects as a list</a>

    <nav class="dock" aria-label="Contact">
      <a href="/resume" aria-label="Résumé" data-app><DockIcon kind="resume" morph="app-resume" /></a>
      <a href={`mailto:${SITE.email}`} aria-label="Email"><DockIcon kind="mail" /></a>
      <a href={SITE.github} aria-label="GitHub" rel="me noopener" target="_blank"><DockIcon kind="github" /></a>
      <a href={SITE.linkedin} aria-label="LinkedIn" rel="me noopener" target="_blank"><DockIcon kind="linkedin" /></a>
    </nav>
  </main>

  <Fragment slot="right">
    <div class="summary">
      <p class="eyebrow">On this phone</p>
      <p class="big">{c.total} apps</p>
      <p class="line">{c.play} on Google Play</p>
      <p class="line">{c.web} you can open on the web</p>
      <p class="line">1 for a client</p>
      <p class="hint">Click an app to open it.<br />Arrow keys and Enter work too.</p>
    </div>
    <DeskThings thing="pen" />
  </Fragment>
</Base>

<script>
  // Arrow-key navigation across the 4-column grid.
  function init() {
    const grid = document.querySelector<HTMLElement>('[data-grid]');
    if (!grid) return;
    const apps = [...grid.querySelectorAll<HTMLAnchorElement>('[data-app]')];
    grid.onkeydown = (e) => {
      const i = apps.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0) return;
      const step = { ArrowRight: 1, ArrowLeft: -1, ArrowDown: 4, ArrowUp: -4 }[e.key];
      if (!step) return;
      e.preventDefault();
      apps[Math.max(0, Math.min(apps.length - 1, i + step))].focus();
    };
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .home {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 62px 0 calc(28px + env(safe-area-inset-bottom));
  }

  .top {
    padding: 0 20px;
  }
  .who {
    display: none;
  }

  .widget {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    border-radius: 24px;
    background: var(--card);
    color: var(--wall-ink);
    text-decoration: none;
    border: 1px solid color-mix(in oklab, var(--wall-ink) 8%, transparent);
  }
  .w-left,
  .w-right {
    display: flex;
    flex-direction: column;
  }
  .w-right {
    text-align: right;
    justify-content: flex-end;
  }
  .w-time {
    font: 400 52px/0.9 var(--serif);
    letter-spacing: -0.02em;
  }
  .w-place {
    margin-top: 8px;
    font-size: 13px;
    color: var(--wall-ink-2);
  }
  .w-label {
    font: 400 11px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--wall-ink-2);
  }
  .w-what {
    margin-top: 6px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .w-sub {
    margin-top: 2px;
    font-size: 12.5px;
    color: var(--wall-ink-2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    row-gap: 22px;
    margin: 26px 0 0;
    padding: 0 14px;
    list-style: none;
  }
  .app {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    text-decoration: none;
    color: var(--wall-ink);
    border-radius: 16px;
    -webkit-tap-highlight-color: transparent;
  }
  .app :global(.ic) {
    transition: transform 0.18s var(--ease-out);
  }
  .app:hover :global(.ic) {
    transform: translateY(-2px);
  }
  .app:active :global(.ic) {
    transform: scale(0.92);
  }
  .lbl {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.005em;
  }

  .all {
    margin: auto auto 14px;
    font-size: 12.5px;
    color: var(--wall-ink-2);
    text-underline-offset: 3px;
  }

  .dock {
    display: flex;
    justify-content: space-around;
    margin: 0 12px;
    padding: 14px 8px;
    border-radius: 34px;
    background: var(--dock);
  }
  .dock a {
    border-radius: 16px;
  }

  @media (max-width: 767px) {
    .home {
      padding-top: calc(env(safe-area-inset-top) + 22px);
    }
    .who {
      display: block;
      margin: 0 4px 18px;
    }
    .who-name {
      margin: 0;
      font: 400 34px/1 var(--serif);
      letter-spacing: -0.01em;
    }
    .who-bio {
      margin: 8px 0 0;
      font-size: 14px;
      line-height: 1.45;
      color: var(--wall-ink-2);
      max-width: 30ch;
    }
  }

  /* Desk, right side */
  .summary {
    color: var(--desk-ink);
  }
  .eyebrow {
    margin: 0 0 12px;
    font: 400 12px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--desk-ink-3);
  }
  .big {
    margin: 0 0 6px;
    font: 400 46px/1 var(--serif);
  }
  .line {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--desk-ink-2);
  }
  .hint {
    margin: 22px 0 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--desk-ink-3);
  }
</style>
