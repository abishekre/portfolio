---
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import DockIcon from '../components/DockIcon.astro';
import IndexCard from '../components/IndexCard.astro';
import DeskThings from '../components/DeskThings.astro';
import { Image } from 'astro:assets';
import { allProjects, counts } from '../lib/projects';
import { SITE } from '../site';
import { HOME } from '../lib/home';

const projects = await allProjects();
const c = counts(projects);
const building = projects.find((p) => p.id === HOME.nowBuilding?.app);
const photoOf = projects.find((p) => p.id === HOME.photo?.app);
const photo = photoOf?.screens[(HOME.photo?.screen ?? 1) - 1];
---

<Base title={SITE.name} description={`${SITE.bio} ${SITE.description}`.trim()}>
  <Fragment slot="left">
    <IndexCard />
    <DeskThings thing="chai" />
  </Fragment>

  <main class="home" data-home>
    <button class="done" type="button" data-done>Done</button>
    <header class="top">
      <div class="who">
        <p class="who-name">{SITE.name}</p>
        <p class="who-bio">{SITE.bio}</p>
      </div>
      <a class="widget" href={building ? `/${building.id}` : '/notes'} aria-label={building ? `Now building: ${building.data.name}` : 'Notes'}>
        <span class="w-left">
          <span class="w-time" data-clock>9:41</span>
          <span class="w-place">{SITE.city} <span data-temp></span></span>
        </span>
        {
          building && (
            <span class="w-right">
              <span class="w-label">Now building</span>
              <span class="w-what">{building.data.label ?? building.data.name}</span>
              <span class="w-sub">{HOME.nowBuilding?.note}</span>
            </span>
          )
        }
      </a>
    </header>

    <ul class="grid" data-grid>
      {
        projects.map((p) => (
          <li>
            <a class="app" href={`/${p.id}`} data-app>
              <AppIcon icon={p.icon} />
              <span class="lbl">{p.data.label ?? p.data.name}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a class="app" href="/notes" data-app>
          <DockIcon kind="notes" />
          <span class="lbl">Notes</span>
        </a>
      </li>
    </ul>

    {
      photoOf && photo && (
        <a class="photo" href={`/${photoOf.id}`} aria-label={`Photo: ${photoOf.data.name}. Open ${photoOf.data.name}`}>
          <Image src={photo} alt="" width={700} />
          <span class="photo-cap">
            <span class="photo-app">Photos</span>
            <span>{HOME.photo?.caption}</span>
          </span>
        </a>
      )
    }

    <a class="all" href="/list">All projects as a list</a>

    <nav class="dock" aria-label="Contact">
      <a href="/resume" aria-label="Résumé" data-app><DockIcon kind="resume" /></a>
      <a href={`mailto:${SITE.email}`} aria-label="Email"><DockIcon kind="mail" /></a>
      <a href={SITE.github} aria-label="GitHub" rel="me noopener" target="_blank"><DockIcon kind="github" /></a>
      <a href={SITE.linkedin} aria-label="LinkedIn" rel="me noopener" target="_blank"><DockIcon kind="linkedin" /></a>
    </nav>
  </main>

  <Fragment slot="right">
    <div class="summary">
      <p class="eyebrow">On this phone</p>
      <p class="big">{c.total} apps</p>
      {c.play > 0 && <p class="line">{c.play} on Google Play</p>}
      {c.web > 0 && <p class="line">{c.web} you can open on the web</p>}
      {c.openSource > 0 && <p class="line">{c.openSource} open source</p>}
      {c.client > 0 && <p class="line">{c.client} made for clients</p>}
      <p class="hint">Click an app to open it.<br />Arrow keys and Enter work too.</p>
    </div>
    <DeskThings thing="pen" />
  </Fragment>
</Base>

<script>
  // Arrow-key navigation across the 4-column grid.
  function init() {
    const grid = document.querySelector<HTMLElement>('[data-grid]');
    if (!grid) return;
    const apps = [...grid.querySelectorAll<HTMLAnchorElement>('[data-app]')];
    grid.onkeydown = (e) => {
      const i = apps.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0) return;
      const step = { ArrowRight: 1, ArrowLeft: -1, ArrowDown: 4, ArrowUp: -4 }[e.key];
      if (!step) return;
      e.preventDefault();
      apps[Math.max(0, Math.min(apps.length - 1, i + step))].focus();
    };

    // Long-press any icon: jiggle mode. Done, Esc or a tap on the wallpaper ends it.
    const home = document.querySelector<HTMLElement>('[data-home]')!;
    let timer = 0;
    let swallowClick = false;
    const stop = () => home.classList.remove('jiggle');
    grid.onpointerdown = (e) => {
      // Mouse only: on phones a long-press belongs to the browser (link preview menu).
      if (e.pointerType !== 'mouse' || !(e.target as HTMLElement).closest('[data-app]')) return;
      timer = window.setTimeout(() => {
        home.classList.add('jiggle');
        swallowClick = true;
        navigator.vibrate?.(12);
      }, 550);
    };
    const cancel = () => clearTimeout(timer);
    grid.onpointerup = cancel;
    grid.onpointerleave = cancel;
    grid.onpointermove = (e) => {
      if (Math.abs(e.movementX) + Math.abs(e.movementY) > 6) cancel();
    };
    grid.oncontextmenu = (e) => {
      if (home.classList.contains('jiggle')) e.preventDefault();
    };
    grid.addEventListener(
      'click',
      (e) => {
        if (swallowClick || home.classList.contains('jiggle')) {
          e.preventDefault();
          e.stopPropagation();
          swallowClick = false;
        }
      },
      true,
    );
    home.querySelector<HTMLButtonElement>('[data-done]')!.onclick = stop;
    home.onclick = (e) => {
      if (home.classList.contains('jiggle') && !(e.target as HTMLElement).closest('[data-app], [data-done]')) stop();
    };
    document.onkeydown = (e) => {
      if (e.key === 'Escape') stop();
    };
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .home {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 62px 0 calc(28px + env(safe-area-inset-bottom));
  }

  .top {
    padding: 0 20px;
  }
  .who {
    display: none;
  }

  .widget {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    border-radius: 24px;
    background: var(--card);
    color: var(--wall-ink);
    text-decoration: none;
    border: 1px solid color-mix(in oklab, var(--wall-ink) 8%, transparent);
  }
  .w-left,
  .w-right {
    display: flex;
    flex-direction: column;
  }
  .w-right {
    text-align: right;
    justify-content: flex-end;
  }
  .w-time {
    font: 400 52px/0.9 var(--serif);
    letter-spacing: -0.02em;
  }
  .w-place {
    margin-top: 8px;
    font-size: 13px;
    color: var(--wall-ink-2);
  }
  .w-label {
    font: 400 11px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--wall-ink-2);
  }
  .w-what {
    margin-top: 6px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .w-sub {
    margin-top: 2px;
    font-size: 12.5px;
    color: var(--wall-ink-2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    row-gap: 22px;
    margin: 26px 0 0;
    padding: 0 14px;
    list-style: none;
  }
  .app {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    text-decoration: none;
    color: var(--wall-ink);
    border-radius: 16px;
    -webkit-tap-highlight-color: transparent;
  }
  .app :global(.ic) {
    transition: transform 0.18s var(--ease-out);
  }
  .app:hover :global(.ic) {
    transform: translateY(-2px);
  }
  .app:active :global(.ic) {
    transform: scale(0.92);
  }
  .lbl {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.005em;
  }

  .photo {
    position: relative;
    display: block;
    margin: 24px 20px 0;
    height: 148px;
    border-radius: 24px;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
    transition: transform 0.6s var(--ease-out);
  }
  .photo:hover :global(img) {
    transform: scale(1.03);
  }
  .photo-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 28px 14px 11px;
    font-size: 12px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent);
  }
  .photo-app {
    font: 400 11px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .all {
    margin: auto auto 14px;
    padding-top: 14px;
    font-size: 12.5px;
    color: var(--wall-ink-2);
    text-underline-offset: 3px;
  }

  .dock {
    display: flex;
    justify-content: space-around;
    margin: 0 12px;
    padding: 14px 8px;
    border-radius: 34px;
    background: var(--dock);
  }
  .dock a {
    border-radius: 16px;
  }

  /* Long-press easter egg: the icons jiggle, like rearranging a real home screen. */
  .done {
    position: absolute;
    top: 60px;
    right: 18px;
    z-index: 3;
    display: none;
    padding: 6px 14px;
    border: 0;
    border-radius: 999px;
    background: var(--wall-ink);
    color: var(--wall);
    font: 600 13px/1 var(--ui);
    cursor: pointer;
  }
  .home.jiggle .done {
    display: block;
  }
  .home.jiggle .app :global(.ic) {
    animation: jig 0.26s ease-in-out infinite alternate;
  }
  .home.jiggle li:nth-child(odd) .app :global(.ic) {
    animation-delay: -0.13s;
  }
  @keyframes jig {
    from {
      transform: rotate(-2.2deg);
    }
    to {
      transform: rotate(2.2deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home.jiggle .app :global(.ic) {
      animation: none;
      outline: 2px dashed var(--wall-ink-2);
      outline-offset: 3px;
    }
  }

  @media (max-width: 767px) {
    .home {
      padding-top: calc(env(safe-area-inset-top) + 22px);
      overflow-y: auto;
    }
    .done {
      top: calc(env(safe-area-inset-top) + 16px);
    }
    .dock {
      position: sticky;
      bottom: calc(10px + env(safe-area-inset-bottom));
      backdrop-filter: blur(12px);
    }
  }
  @media (max-width: 767px) and (max-height: 899px) {
    .photo {
      display: none;
    }
    .who {
      display: block;
      margin: 0 4px 18px;
    }
    .who-name {
      margin: 0;
      font: 400 34px/1 var(--serif);
      letter-spacing: -0.01em;
    }
    .who-bio {
      margin: 8px 0 0;
      font-size: 14px;
      line-height: 1.45;
      color: var(--wall-ink-2);
      max-width: 30ch;
    }
  }

  /* Desk, right side */
  .summary {
    color: var(--desk-ink);
  }
  .eyebrow {
    margin: 0 0 12px;
    font: 400 12px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--desk-ink-3);
  }
  .big {
    margin: 0 0 6px;
    font: 400 46px/1 var(--serif);
  }
  .line {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--desk-ink-2);
  }
  .hint {
    margin: 22px 0 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--desk-ink-3);
  }
</style>
