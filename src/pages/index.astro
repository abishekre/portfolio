---
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import DockIcon from '../components/DockIcon.astro';
import LockScreen from '../components/LockScreen.astro';
import { Image } from 'astro:assets';
import { allProjects } from '../lib/projects';
import { SITE } from '../site';
import { HOME } from '../lib/home';
import { RESUME, CERTS } from '../lib/resume';
import { monthYear } from '../lib/yaml';

const projects = await allProjects();
const building = projects.find((p) => p.id === HOME.nowBuilding?.app);
const photoOf = projects.find((p) => p.id === HOME.photo?.app);
const photo = photoOf?.screens[(HOME.photo?.screen ?? 1) - 1];

// Work page: the current job, and a small timeline of jobs and degrees.
const job = RESUME.experience[0];
const timeline = [
  ...RESUME.experience.map((j) => ({ when: j.start, label: j.company })),
  ...RESUME.education.map((e) => ({ when: String(e.start), label: e.degree.split(',')[0] })),
].sort((a, b) => a.when.localeCompare(b.when));
---

<Base title={SITE.name} description={`${SITE.bio} ${SITE.description}`.trim()}>

  <main class="home" data-home>
    <button class="done" type="button" data-done>Done</button>
    <button class="done reset" type="button" data-reset hidden>Reset</button>

    <div class="pages" data-pages>
      <section class="page" aria-label="Apps">
        <header class="top">
          <div class="who">
            <p class="who-name">{SITE.name}</p>
            <p class="who-bio">{SITE.bio}</p>
          </div>
          <div class="widget">
            <button class="w-left" type="button" data-dev-tap>
              <span class="w-time" data-clock></span>
              <span class="w-place">{SITE.city} <span data-temp></span></span>
            </button>
            {
              building && (
                <a class="w-right" href={`/${building.id}`}>
                  <span class="w-label">Now building</span>
                  <span class="w-what">{building.data.label ?? building.data.name}</span>
                  <span class="w-sub">{HOME.nowBuilding?.note}</span>
                </a>
              )
            }
          </div>
        </header>

        <ul class="grid" data-grid>
          {
            projects.map((p) => (
              <li>
                <a class="app" href={`/${p.id}`} data-app>
                  <AppIcon icon={p.icon} />
                  <span class="lbl">{p.data.label ?? p.data.name}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a class="app" href="/notes" data-app>
              <DockIcon kind="notes" />
              <span class="lbl">Notes</span>
            </a>
          </li>
        </ul>

        {
          photoOf && photo && (
            <a class="photo" href={`/${photoOf.id}`} aria-label={`Photo: ${photoOf.data.name}. Open ${photoOf.data.name}`}>
              <Image src={photo} alt="" width={700} />
              <span class="photo-cap">
                <span class="photo-app">Photos</span>
                <span>{HOME.photo?.caption}</span>
              </span>
            </a>
          )
        }

      </section>

      <section class="page work" aria-label="Work">
        <div class="who who-work">
          <p class="who-name">Day job</p>
          <p class="who-bio">Master data for enterprise customers, at {job.company}.</p>
        </div>
        <a class="job" href="/work">
          <span class="j-label">{job.company} · since {monthYear(job.start)}</span>
          <span class="j-role">{job.role}</span>
          <span class="j-tools">{job.tools.join(' · ')}</span>
        </a>

        <a class="tl" href="/resume" aria-label="Timeline. Open the résumé">
          <span class="tl-label">So far</span>
          <ol>
            {
              timeline.map((t) => (
                <li>
                  <span class="tl-year">{t.when.slice(0, 4)}</span>
                  <span class="tl-what">{t.label}</span>
                </li>
              ))
            }
          </ol>
        </a>

        <ul class="grid work-grid" data-grid-work>
          <li>
            <a class="app" href="/work" data-app>
              <DockIcon kind="work" />
              <span class="lbl">Work</span>
            </a>
          </li>
          <li>
            <a class="app" href="/wallet" data-app>
              <DockIcon kind="wallet" />
              <span class="lbl">Wallet</span>
            </a>
          </li>
          <li>
            <a class="app" href="/resume" data-app>
              <DockIcon kind="resume" />
              <span class="lbl">Résumé</span>
            </a>
          </li>
          <li data-dev-app hidden>
            <a class="app" href="/developer" data-app>
              <DockIcon kind="dev" />
              <span class="lbl">Developer</span>
            </a>
          </li>
        </ul>
        {CERTS.length > 0 && <p class="work-note">{CERTS.length} certifications and badges in the Wallet</p>}
      </section>
    </div>

    <div class="pager">
      <span class="pager-side"><a class="all" href="/list">List view</a></span>
      <div class="dots" role="group" aria-label="Home screen pages">
        <button type="button" class="dot on" data-dot="0" aria-label="Apps page" aria-current="true"></button>
        <button type="button" class="dot" data-dot="1" aria-label="Work page"></button>
      </div>
      <span class="pager-side">
        <button type="button" class="lockbtn" data-cc-btn aria-label="Control Center: appearance and lock">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h9M16 6h1M3 14h1M8 14h9"></path><circle cx="14" cy="6" r="2"></circle><circle cx="6" cy="14" r="2"></circle></svg>
        </button>
      </span>
    </div>

    <nav class="dock" aria-label="Contact">
      <a href="/resume" aria-label="Résumé" data-app><DockIcon kind="resume" /></a>
      <a href={`mailto:${SITE.email}`} aria-label="Email"><DockIcon kind="mail" /></a>
      <a href={SITE.github} aria-label="GitHub" rel="me noopener" target="_blank"><DockIcon kind="github" /></a>
      <a href={SITE.linkedin} aria-label="LinkedIn" rel="me noopener" target="_blank"><DockIcon kind="linkedin" /></a>
    </nav>
  </main>

  <LockScreen />

</Base>

<script>
  import { calm } from '../lib/spring';

  function init() {
    const home = document.querySelector<HTMLElement>('[data-home]');
    if (!home) return;
    const pages = home.querySelector<HTMLElement>('[data-pages]')!;
    const grid = home.querySelector<HTMLElement>('[data-grid]')!;
    const workGrid = home.querySelector<HTMLElement>('[data-grid-work]')!;
    const dots = [...home.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    // For the unlock animation: how far each icon is from the middle of its grid.
    home.querySelectorAll<HTMLElement>('.grid').forEach((g) => {
      const items = [...g.children] as HTMLElement[];
      const rows = Math.ceil(items.length / 4);
      items.forEach((li, i) => {
        const dx = (i % 4) - 1.5;
        const dy = Math.floor(i / 4) - (rows - 1) / 2;
        li.style.setProperty('--d', Math.hypot(dx, dy).toFixed(2));
      });
    });

    // Pages: native horizontal scrolling with snap; the dots follow and can be tapped.
    const current = () => Math.round(pages.scrollLeft / pages.clientWidth);
    const goPage = (i: number) => pages.scrollTo({ left: i * pages.clientWidth, behavior: 'smooth' });
    const mark = () => {
      const i = current();
      dots.forEach((d, j) => {
        d.classList.toggle('on', i === j);
        if (i === j) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    };
    pages.addEventListener('scroll', mark, { passive: true });
    mark(); // the page may already have been restored (coming back from an app on page two)
    dots.forEach((d, i) => (d.onclick = () => goPage(i)));

    // Arrow keys: around the grid, and across to the other page at the edges.
    let apps = [...grid.querySelectorAll<HTMLAnchorElement>('[data-app]')];
    const work = () => [...workGrid.querySelectorAll<HTMLAnchorElement>('li:not([hidden]) [data-app]')];
    grid.onkeydown = (e) => {
      const i = apps.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0) return;
      if (e.key === 'ArrowRight' && (i % 4 === 3 || i === apps.length - 1)) {
        e.preventDefault();
        goPage(1);
        work()[0]?.focus({ preventScroll: true });
        return;
      }
      const step = ({ ArrowRight: 1, ArrowLeft: -1, ArrowDown: 4, ArrowUp: -4 } as Record<string, number>)[e.key];
      if (!step) return;
      e.preventDefault();
      apps[Math.max(0, Math.min(apps.length - 1, i + step))].focus();
    };
    workGrid.onkeydown = (e) => {
      const list = work();
      const i = list.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0) return;
      if (e.key === 'ArrowLeft' && i % 4 === 0) {
        e.preventDefault();
        goPage(0);
        apps[Math.min(3, apps.length - 1)].focus({ preventScroll: true });
        return;
      }
      const step = ({ ArrowRight: 1, ArrowLeft: -1, ArrowDown: 4, ArrowUp: -4 } as Record<string, number>)[e.key];
      if (!step) return;
      e.preventDefault();
      list[Math.max(0, Math.min(list.length - 1, i + step))].focus();
    };
    // Tabbing onto the other page brings it into view.
    pages.addEventListener('focusin', (e) => {
      const page = (e.target as HTMLElement).closest('.page');
      const i = [...pages.children].indexOf(page as Element);
      if (i >= 0 && i !== current()) goPage(i);
    });

    home.querySelector<HTMLButtonElement>('[data-cc-btn]')!.onclick = () => window.__cc?.open();

    // Developer options: tap the clock seven times, like the build number on Android.
    const devApp = home.querySelector<HTMLElement>('[data-dev-app]')!;
    const isDev = () => !!window.__eggs?.().includes('dev');
    devApp.hidden = !isDev();
    let taps = 0;
    let last = 0;
    home.querySelector<HTMLButtonElement>('[data-dev-tap]')!.onclick = () => {
      const now = Date.now();
      if (now - last > 2500) taps = 0;
      last = now;
      taps++;
      if (isDev()) {
        if (taps >= 3) window.__toast?.('No need, you are already a developer.');
        return;
      }
      const left = 7 - taps;
      if (left <= 0) {
        window.__egg?.('dev');
        window.__toast?.('You are now a developer! Developer options is on page two.', 3400);
        devApp.hidden = false;
        taps = 0;
      } else if (left <= 4) {
        window.__toast?.(`You are now ${left} step${left > 1 ? 's' : ''} away from being a developer.`, 1400);
      }
    };

    // First unlock ever: peek at page two once, the way a phone teaches swiping.
    const peek = () => {
      try {
        if (localStorage.getItem('pf-peeked')) return;
        localStorage.setItem('pf-peeked', '1');
      } catch {
        return;
      }
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || current() !== 0) return;
      setTimeout(() => {
        for (const page of pages.children) {
          (page as HTMLElement).animate(
            [{ transform: 'translateX(0)' }, { transform: 'translateX(-38px)' }, { transform: 'translateX(0)' }],
            { duration: 1000, easing: 'cubic-bezier(0.32, 0.72, 0, 1)' },
          );
        }
      }, 450);
    };
    document.addEventListener('pf:unlocked', peek, { once: true });

    // Edit mode (the jiggle): press and hold any icon — mouse or finger — and the icons start to jiggle.
    // Drag one to move it; the others slide out of the way. Done keeps your arrangement (in this
    // browser); Reset puts it back. Arrow keys move the focused icon while editing.
    const KEY = 'pf-order';
    const lis = () => [...grid.children] as HTMLElement[];
    const hrefOf = (li: Element) => li.querySelector('[data-app]')?.getAttribute('href') ?? '';
    const defaultOrder = lis().map(hrefOf);
    const resetBtn = home.querySelector<HTMLButtonElement>('[data-reset]')!;
    const saved = (() => {
      try {
        return JSON.parse(localStorage.getItem(KEY) ?? 'null') as string[] | null;
      } catch {
        return null;
      }
    })();
    const applyOrder = (order: string[]) => {
      const byHref = new Map(lis().map((li) => [hrefOf(li), li]));
      order.forEach((h) => byHref.get(h) && grid.append(byHref.get(h)!));
      lis().forEach((li) => !order.includes(hrefOf(li)) && grid.append(li)); // new apps go at the end
    };
    if (saved) applyOrder(saved);
    const isCustom = () => lis().map(hrefOf).join() !== defaultOrder.join();
    const syncReset = () => (resetBtn.hidden = !isCustom());

    // FLIP: move elements in the DOM, then animate each from where it was to where it is.
    const flip = (change: () => void, skip?: HTMLElement) => {
      const before = new Map(lis().map((li) => [li, li.getBoundingClientRect()]));
      change();
      if (calm()) return;
      for (const li of lis()) {
        if (li === skip) continue;
        const a = before.get(li)!;
        const b = li.getBoundingClientRect();
        const dx = a.left - b.left;
        const dy = a.top - b.top;
        if (!dx && !dy) continue;
        li.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], {
          duration: 320,
          easing: 'cubic-bezier(0.32, 0.72, 0, 1)',
        });
      }
    };

    let timer = 0;
    let swallowClick = false;
    const start = () => {
      if (home.classList.contains('jiggle')) return;
      home.classList.add('jiggle');
      syncReset();
      window.__egg?.('jiggle');
      navigator.vibrate?.(12);
    };
    const stop = () => {
      if (!home.classList.contains('jiggle')) return;
      home.classList.remove('jiggle');
      try {
        if (isCustom()) localStorage.setItem(KEY, JSON.stringify(lis().map(hrefOf)));
        else localStorage.removeItem(KEY);
      } catch {}
      apps = [...grid.querySelectorAll<HTMLAnchorElement>('[data-app]')];
    };
    try {
      if (sessionStorage.getItem('pf-jiggle')) {
        sessionStorage.removeItem('pf-jiggle');
        setTimeout(start, 500);
      }
    } catch {}

    // Press and hold (any pointer) to start; moving more than a few pixels means a scroll, not a hold.
    let downX = 0;
    let downY = 0;
    pages.addEventListener('pointerdown', (e) => {
      const app = (e.target as HTMLElement).closest('[data-app]');
      if (!app || home.classList.contains('jiggle')) return;
      downX = e.clientX;
      downY = e.clientY;
      timer = window.setTimeout(() => {
        start();
        swallowClick = true;
      }, 520);
    });
    const cancel = () => clearTimeout(timer);
    pages.addEventListener('pointerup', cancel);
    pages.addEventListener('pointercancel', cancel);
    pages.addEventListener('pointermove', (e) => {
      if (Math.hypot(e.clientX - downX, e.clientY - downY) > 8) cancel();
    });
    // The browser's own long-press menu would cover the icons; on icons, holding means edit.
    grid.addEventListener('contextmenu', (e) => {
      if ((e.target as HTMLElement).closest('[data-app]')) e.preventDefault();
    });
    pages.addEventListener(
      'click',
      (e) => {
        if (swallowClick || home.classList.contains('jiggle')) {
          e.preventDefault();
          e.stopPropagation();
          swallowClick = false;
        }
      },
      true,
    );

    // Dragging an icon while editing.
    let dragLi: HTMLElement | null = null;
    let grabX = 0;
    let grabY = 0;
    const place = (e: PointerEvent) => {
      const r = dragLi!.getBoundingClientRect();
      const cur = new DOMMatrix(getComputedStyle(dragLi!).transform);
      const baseX = r.left - cur.m41;
      const baseY = r.top - cur.m42;
      dragLi!.style.transform = `translate(${e.clientX - grabX - baseX}px, ${e.clientY - grabY - baseY}px) scale(1.12)`;
    };
    grid.addEventListener('pointerdown', (e) => {
      if (!home.classList.contains('jiggle')) return;
      const li = (e.target as HTMLElement).closest<HTMLElement>('li');
      if (!li || !grid.contains(li)) return;
      e.preventDefault();
      dragLi = li;
      const r = li.getBoundingClientRect();
      grabX = e.clientX - r.left;
      grabY = e.clientY - r.top;
      li.classList.add('lifted');
      li.setPointerCapture(e.pointerId);
      place(e);
    });
    grid.addEventListener('pointermove', (e) => {
      if (!dragLi) return;
      place(e);
      // Which slot is the pointer over? Move the icon there; the rest make room.
      const over = lis().find((li) => {
        if (li === dragLi) return false;
        const r = li.getBoundingClientRect();
        return e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      });
      if (!over) return;
      const items = lis();
      const from = items.indexOf(dragLi);
      const to = items.indexOf(over);
      flip(() => (from < to ? over.after(dragLi!) : over.before(dragLi!)), dragLi);
      place(e);
      syncReset();
    });
    const drop = () => {
      if (!dragLi) return;
      const li = dragLi;
      dragLi = null;
      li.classList.remove('lifted');
      li.style.transition = 'transform 0.3s cubic-bezier(0.32, 0.72, 0, 1)';
      li.style.transform = '';
      setTimeout(() => (li.style.transition = ''), 320);
    };
    grid.addEventListener('pointerup', drop);
    grid.addEventListener('pointercancel', drop);

    // Keyboard: while editing, arrows move the focused icon.
    grid.addEventListener('keydown', (e) => {
      if (!home.classList.contains('jiggle')) return;
      const li = (document.activeElement as HTMLElement)?.closest('li');
      if (!li || !grid.contains(li)) return;
      const items = lis();
      const i = items.indexOf(li);
      const step = ({ ArrowRight: 1, ArrowLeft: -1, ArrowDown: 4, ArrowUp: -4 } as Record<string, number>)[e.key];
      if (!step) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      const j = Math.max(0, Math.min(items.length - 1, i + step));
      if (j === i) return;
      flip(() => (j > i ? items[j].after(li) : items[j].before(li)));
      li.querySelector<HTMLElement>('[data-app]')!.focus();
      syncReset();
    }, true);

    resetBtn.onclick = (e) => {
      e.stopPropagation();
      flip(() => applyOrder(defaultOrder));
      syncReset();
    };
    home.querySelector<HTMLButtonElement>('[data-done]')!.onclick = (e) => {
      e.stopPropagation();
      stop();
    };
    home.onclick = (e) => {
      if (home.classList.contains('jiggle') && !(e.target as HTMLElement).closest('[data-app], [data-done], [data-reset], li')) stop();
    };
    document.onkeydown = (e) => {
      if (e.key === 'Escape') stop();
    };
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .home {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 62px 0 calc(28px + env(safe-area-inset-bottom));
  }

  /* Two home-screen pages side by side: native horizontal scroll, snapping a page at a time. */
  .pages {
    flex: 1;
    min-height: 0;
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    /* A swipe past the last page stays here instead of becoming the browser's Back. */
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .pages::-webkit-scrollbar {
    display: none;
  }
  .page {
    flex: 0 0 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .page::-webkit-scrollbar {
    display: none;
  }
  .page > * {
    flex-shrink: 0;
  }

  .top {
    padding: 0 20px;
  }
  .who {
    display: none;
  }

  .widget {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    border-radius: 24px;
    background: var(--card);
    color: var(--wall-ink);
    border: 1px solid color-mix(in oklab, var(--wall-ink) 8%, transparent);
  }
  .w-left {
    align-items: flex-start;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: default;
    user-select: none;
  }
  .w-left:active .w-time {
    opacity: 0.7;
  }
  .w-right {
    color: inherit;
    text-decoration: none;
  }
  .w-left,
  .w-right {
    display: flex;
    flex-direction: column;
  }
  .w-right {
    text-align: right;
    justify-content: flex-end;
  }
  .w-time {
    font: 800 54px/0.88 var(--sys);
    font-stretch: 70%;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .w-place {
    margin-top: 8px;
    font-size: 13px;
    color: var(--wall-ink-2);
  }
  .w-label {
    font: 600 12.5px/1 var(--sys);
    letter-spacing: 0.01em;
    color: var(--wall-ink-2);
  }
  .w-what {
    margin-top: 6px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .w-sub {
    margin-top: 2px;
    font-size: 12.5px;
    color: var(--wall-ink-2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    row-gap: 22px;
    margin: 26px 0 0;
    padding: 0 14px;
    list-style: none;
  }
  .app {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    text-decoration: none;
    color: var(--wall-ink);
    border-radius: 16px;
    -webkit-tap-highlight-color: transparent;
  }
  .app :global(.ic) {
    transition:
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.2s ease;
  }
  .app:hover :global(.ic) {
    transform: translateY(-2px);
  }
  .app:active :global(.ic) {
    transform: scale(0.9);
    filter: brightness(0.82);
    transition-duration: 0.12s;
  }
  .lbl {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.005em;
  }

  .photo {
    position: relative;
    display: block;
    margin: 24px 20px 0;
    height: 148px;
    border-radius: 24px;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
    transition: transform 0.6s var(--ease-out);
  }
  .photo:hover :global(img) {
    transform: scale(1.03);
  }
  .photo-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 28px 14px 11px;
    font-size: 12px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent);
  }
  .photo-app {
    font: 600 12.5px/1 var(--sys);
    letter-spacing: 0.01em;
  }

  .all {
    justify-self: start;
    font-size: 12.5px;
    color: var(--wall-ink-2);
    text-underline-offset: 3px;
  }

  /* Work page */
  .work {
