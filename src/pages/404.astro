---
import Base from '../layouts/Base.astro';
import IndexCard from '../components/IndexCard.astro';
import { SITE } from '../site';
---

<Base title={`App not installed · ${SITE.name}`} description="That page doesn't exist.">
  <Fragment slot="left"><IndexCard /></Fragment>
  <main class="nf">
    <div class="ghost" aria-hidden="true"></div>
    <h1>App not installed</h1>
    <p>There's nothing at this address.</p>
    <a href="/">Back to the home screen</a>
  </main>
</Base>

<style>
  .nf {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 24px;
    text-align: center;
  }
  .ghost {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    border: 2px dashed var(--wall-ink-2);
    margin-bottom: 18px;
  }
  h1 {
    margin: 0;
    font: 400 34px/1 var(--serif);
  }
  p {
    margin: 4px 0 14px;
    color: var(--wall-ink-2);
  }
  a {
    color: var(--wall-ink);
    font-weight: 500;
    text-underline-offset: 3px;
  }
</style>
