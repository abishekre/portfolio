---
// 1200×630 share card for each project. scripts/og.mjs screenshots these into public/og/.
import { Image } from 'astro:assets';
import { allProjects, type Project } from '../../lib/projects';
import { SITE } from '../../site';

export async function getStaticPaths() {
  return (await allProjects()).map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
const d = project.data;
const t = d.theme;
const shot = project.screens[0];
const fonts =
  'https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=Space+Mono&' + (t.fonts ?? '') + '&display=swap';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="stylesheet" href={fonts} />
    <title>{d.name} share card</title>
  </head>
  <body style={`--bg:${t.bg};--fg:${t.fg};--muted:${t.muted};--line:${t.line};--display:${t.display}`}>
    <main class:list={['card', { wide: d.screensWide }]}>
      <div class="text">
        <Image src={project.icon} alt="" width={240} height={240} class="icon" />
        <h1>{d.name}</h1>
        <p class="tag">{d.tagline}</p>
        <p class="foot">abishekre.in · {SITE.name}</p>
      </div>
      {shot && <Image src={shot} alt="" width={900} class="shot" />}
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
  }
  body {
    background: var(--bg);
    color: var(--fg);
    font-family: 'Inter Tight', system-ui, sans-serif;
  }
  .card {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    display: flex;
  }
  .text {
    width: 640px;
    padding: 64px 0 56px 72px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }
  .icon {
    width: 112px;
    height: 112px;
    border-radius: 26px;
  }
  h1 {
    margin: 34px 0 0;
    font: 700 96px/0.95 var(--display);
    letter-spacing: -0.035em;
  }
  .tag {
    margin: 22px 0 0;
    font-size: 30px;
    line-height: 1.3;
    max-width: 520px;
  }
  .foot {
    margin: auto 0 0;
    font: 400 18px/1 'Space Mono', monospace;
    color: var(--muted);
  }
  .shot {
    position: absolute;
    right: 70px;
    top: 56px;
    width: 340px;
    height: auto;
    border-radius: 34px;
    border: 1px solid var(--line);
  }
  .wide .shot {
    right: -120px;
    top: 120px;
    width: 640px;
    border-radius: 18px;
  }
</style>
