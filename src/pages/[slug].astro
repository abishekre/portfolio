---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AppShell from '../components/AppShell.astro';
import AppIcon from '../components/AppIcon.astro';
import BuildNotes from '../components/BuildNotes.astro';
import { allProjects, ogImageFor, type Project } from '../lib/projects';
import { projectSheet } from '../lib/sheet';
import { SITE } from '../site';

export async function getStaticPaths() {
  const list = await allProjects();
  return list.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: list[(i - 1 + list.length) % list.length], next: list[(i + 1) % list.length] },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}
const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
---

<Base
  title={`${d.name} · ${SITE.name}`}
  description={d.tagline}
  fonts={d.theme.fonts}
 
  statusInk={d.theme.fg}
  ogImage={ogImageFor(project.id)}
  sheet={projectSheet(project, next)}
>

  <AppShell slug={project.id} theme={d.theme} label={d.name}>
    <header class="hero">
      <AppIcon icon={project.icon} size={76} />
      <h1>{d.name}</h1>
      <p class="tagline">{d.tagline}</p>
      <p class="status"><span class="dot"></span>{d.status}</p>
    </header>

    {
      project.screens.length > 0 && (
        <div class:list={['screens', { wide: d.screensWide }]} tabindex="0" aria-label={d.screensAlt ?? `${d.name} screenshots`}>
          {project.screens.map((s, i) => (
            <Image src={s} alt={`${d.name} screen ${i + 1}`} width={d.screensWide ? 700 : 460} loading={i < 2 ? 'eager' : 'lazy'} />
          ))}
        </div>
      )
    }

    {
      project.screens.length === 0 && d.design && (
        <section class="design" aria-label={`${d.name} design system`}>
          <p class="eyebrow">Design system</p>
          {d.design.title && <p class="d-title">{d.design.title}</p>}
          <ul class="swatches">
            {d.design.swatches.map((c) => (
              <li>
                <span class="chip" style={`background:${c.value}`} />
                <b>{c.name}</b>
                <code>{c.value}</code>
                {c.note && <small>{c.note}</small>}
              </li>
            ))}
          </ul>
          <ul class="type">
            {d.design.type.map((t) => (
              <li>
                <span class="sample" style={`font-family:'${t.family}','${t.family} Variable',system-ui,sans-serif;font-weight:${t.weight};font-size:${t.size}px`}>
                  {t.sample}
                </span>
                <small>
                  {t.name} · {t.family} {t.weight}
                </small>
              </li>
            ))}
          </ul>
          {d.design.rules.length > 0 && (
            <ol class="rules">
              {d.design.rules.map((rule) => (
                <li>{rule}</li>
              ))}
            </ol>
          )}
        </section>
      )
    }

    <ul class="stats">
      {
        d.stats.map((s) => (
          <li>
            <span class="v">{s.value}</span>
            <span class="l">{s.label}</span>
          </li>
        ))
      }
    </ul>

    <section>
      <h2 class="eyebrow">What it is</h2>
      <p class="what">{d.what}</p>
    </section>

    <section class="hard">
      <h2 class="eyebrow">The hard part</h2>
      <p class="hard-title">{d.hardTitle}</p>
      <div class="prose"><Content /></div>
    </section>

    {
      project.links.length > 0 && (
        <div class="links">
          {project.links.map((l) => (
            <a class:list={['btn', { primary: l.primary }]} href={l.href} target="_blank" rel="noopener">
              {l.label}
            </a>
          ))}
        </div>
      )
    }

    <div class="in-app-notes">
      <BuildNotes project={project} variant="app" />
    </div>

    <nav class="pn" aria-label="More projects">
      <a href={`/${prev.id}`}>← {prev.data.label ?? prev.data.name}</a>
      <a href={`/${next.id}`}>{next.data.label ?? next.data.name} →</a>
    </nav>
  </AppShell>

</Base>

<style>
  .design {
    margin-top: 22px;
    padding: 18px;
    border: 1px solid var(--app-line);
    border-radius: 18px;
  }
  .d-title {
    margin: 8px 0 14px;
    font: 700 19px/1.25 var(--app-display);
  }
  .swatches {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 12px;
  }
  .swatches li {
    display: grid;
    grid-template-columns: 34px 1fr;
    column-gap: 10px;
    align-items: start;
  }
  .chip {
    grid-row: span 3;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--app-fg) 18%, transparent);
  }
  .swatches b {
    font-size: 13.5px;
    font-weight: 600;
  }
  .swatches code {
    font: 500 12.5px/1.4 var(--sys);
    color: var(--app-muted);
  }
  .swatches small,
  .type small {
    font-size: 12px;
    line-height: 1.35;
    color: var(--app-muted);
  }
  .type {
    margin: 18px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid var(--app-line);
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .type li {
    display: grid;
    gap: 4px;
  }
  .sample {
    line-height: 1.05;
    font-feature-settings: 'tnum';
  }
  .rules {
    margin: 16px 0 0;
    padding: 14px 0 0 18px;
    border-top: 1px solid var(--app-line);
    display: grid;
    gap: 6px;
    font-size: 13.5px;
    line-height: 1.45;
  }
  .rules li::marker {
    color: var(--app-accent);
    font-weight: 600;
  }

  .hero {
    padding-top: 6px;
  }
  h1 {
    margin: 18px 0 0;
    font: 700 40px/1 var(--app-display);
    letter-spacing: -0.03em;
  }
  .tagline {
    margin: 10px 0 0;
    font-size: 17px;
    line-height: 1.45;
    color: var(--app-fg);
    opacity: 0.86;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 14px 0 0;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 500;
    border: 1px solid var(--app-line);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--app-accent);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--app-fg) 25%, transparent);
  }

  .screens {
    display: flex;
    gap: 10px;
    margin: 26px -22px 0;
    padding: 0 22px 4px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 22px;
    scrollbar-width: none;
  }
  .screens::-webkit-scrollbar {
    display: none;
  }
  .screens :global(img) {
    flex: none;
    width: 200px;
    height: auto;
    border-radius: 16px;
    scroll-snap-align: start;
    border: 1px solid var(--app-line);
  }
  .screens.wide :global(img) {
    width: 320px;
    border-radius: 10px;
  }
  .screens.wide :global(img:only-child) {
    width: 100%;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 28px 0 0;
    padding: 18px 0 0;
    list-style: none;
    border-top: 1px solid var(--app-line);
  }
  .stats li {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .v {
    font: 700 26px/1 var(--app-display);
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .l {
    font-size: 12px;
    line-height: 1.35;
    color: var(--app-muted);
  }

  section {
    margin-top: 30px;
  }
  .eyebrow {
    margin: 0 0 10px;
    font: 600 12.5px/1 var(--sys);
    letter-spacing: 0.01em;
    color: var(--app-muted);
  }
  .what {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
  }
  .hard {
    padding-top: 24px;
    border-top: 1px solid var(--app-line);
  }
  .hard-title {
    margin: 0 0 12px;
    font: 700 24px/1.12 var(--app-display);
    letter-spacing: -0.02em;
  }
  .prose :global(p) {
    margin: 0 0 12px;
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.92;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 26px;
  }
  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 15.5px;
    font-weight: 600;
    text-decoration: none;
    color: var(--app-fg);
    border: 1px solid var(--app-line);
  }
  .btn.primary {
    background: var(--app-accent);
    color: var(--app-on-accent);
    border-color: transparent;
  }
  .btn:active {
    transform: scale(0.98);
  }

  .in-app-notes {
    display: none;
    margin-top: 34px;
    padding-top: 22px;
    border-top: 1px solid var(--app-line);
  }

  .pn {
    display: flex;
    justify-content: space-between;
    margin-top: 34px;
    font-size: 14px;
  }
  .pn a {
    color: var(--app-muted);
    text-decoration: none;
  }
  .pn a:hover {
    color: var(--app-fg);
  }

  /* Desk */

  @media (max-width: 767px) {
    .in-app-notes {
      display: block;
    }
  }
</style>
