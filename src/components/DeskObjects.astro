---
// Paper things on the desk beside the phone. All CSS and real images, so they stay sharp at any size,
// and all sharing one paper shadow (--paper-shadow in global.css).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props =
  | { kind: 'badge'; title: string; role: string; line: string; href: string }
  | { kind: 'polaroid'; image: ImageMetadata; caption: string; href: string; tilt?: number }
  | { kind: 'sticky'; title: string; text: string; href: string };

const props = Astro.props;
---

{
  props.kind === 'badge' && (
    <a class="badge" href={props.href} aria-label={`${props.title}: ${props.role}`}>
      <span class="strap" aria-hidden="true" />
      <span class="clip" aria-hidden="true" />
      <span class="b-band">{props.title}</span>
      <span class="b-role">{props.role}</span>
      <span class="b-line">{props.line}</span>
      <span class="b-code" aria-hidden="true" />
    </a>
  )
}

{
  props.kind === 'polaroid' && (
    <a class="polaroid" href={props.href} style={`--tilt:${props.tilt ?? -3}deg`}>
      <Image src={props.image} alt="" width={360} />
      <span class="p-cap">{props.caption}</span>
    </a>
  )
}

{
  props.kind === 'sticky' && (
    <a class="sticky" href={props.href}>
      <span class="s-title">{props.title}</span>
      <span class="s-text">{props.text.split('@').map((part, i) => (i ? <>@<wbr />{part}</> : part))}</span>
    </a>
  )
}

<style>
  a {
    color: inherit;
    text-decoration: none;
  }

  /* A lanyard ID for the day job: the strap runs up off the top of the desk. */
  .badge {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 196px;
    margin: 70px 0 0 34px;
    padding: 0 0 16px;
    border-radius: 12px;
    background: #fbfaf7;
    color: #1d1a16;
    box-shadow: var(--paper-shadow);
    transform: rotate(3.5deg);
    transform-origin: 50% -90px;
    transition: transform 0.6s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .badge:hover {
    transform: rotate(1.5deg);
  }
  .strap {
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 22px;
    height: 160px;
    margin: 0 0 6px -11px;
    background: repeating-linear-gradient(0deg, #0b3b6e 0 6px, #0d4580 6px 7px);
    box-shadow: 0 6px 12px -6px rgba(0, 0, 0, 0.4);
  }
  .clip {
    position: absolute;
    left: 50%;
    top: -12px;
    width: 30px;
    height: 18px;
    margin-left: -15px;
    border-radius: 4px;
    background: linear-gradient(#d9d9d6, #a9a9a5);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }
  .b-band {
    padding: 22px 16px 12px;
    border-radius: 12px 12px 0 0;
    background: #0b3b6e;
    color: #f4f0e8;
    font: 400 10.5px/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .b-role {
    padding: 14px 16px 0;
    font: 400 24px/1.02 var(--serif);
  }
  .b-line {
    padding: 8px 16px 0;
    font-size: 12.5px;
    color: #6f675b;
  }
  .b-code {
    height: 18px;
    margin: 14px 16px 0;
    background: repeating-linear-gradient(90deg, #1d1a16 0 2px, transparent 2px 4px, #1d1a16 4px 5px, transparent 5px 8px);
    opacity: 0.75;
  }

  /* A polaroid of the app being built, with a strip of tape. */
  .polaroid {
    position: relative;
    display: block;
    width: 190px;
    padding: 10px 10px 0;
    background: #fdfcf9;
    box-shadow: var(--paper-shadow);
    transform: rotate(var(--tilt));
    transition: transform 0.6s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .polaroid:hover {
    transform: rotate(calc(var(--tilt) * 0.4)) translateY(-3px);
  }
  .polaroid::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -12px;
    width: 76px;
    height: 24px;
    margin-left: -38px;
    background: rgba(236, 226, 196, 0.72);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.06);
    transform: rotate(-4deg);
  }
  .polaroid :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 0;
    filter: saturate(0.92) contrast(1.02);
  }
  .p-cap {
    display: block;
    padding: 10px 2px 14px;
    font: italic 400 18px/1 var(--serif);
    color: #2b2620;
    text-align: center;
  }

  /* A sticky note. */
  .sticky {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 178px;
    min-height: 150px;
    padding: 18px 16px;
    background: linear-gradient(170deg, #f7dc78, #f1cf5c);
    color: #3a2f12;
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.1),
      0 14px 18px -12px rgba(0, 0, 0, 0.45);
    transform: rotate(4deg);
    transition: transform 0.6s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .sticky:hover {
    transform: rotate(2deg) translateY(-2px);
  }
  .s-title {
    font: 400 11px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .s-text {
    font: italic 400 19px/1.2 var(--serif);
  }

  /* Short screens: the desk gets crowded, so the ID card and polaroid step aside. */
  @media (max-height: 820px) {
    .badge,
    .polaroid {
      display: none;
    }
  }
  @media (max-width: 1099px) {
    .badge,
    .polaroid,
    .sticky {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge,
    .polaroid,
    .sticky {
      transition: none;
    }
  }
</style>
