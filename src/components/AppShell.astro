---
// The full-screen "open app" inside the phone. Every project, Notes and Résumé use it.
interface Theme {
  bg: string;
  fg: string;
  muted: string;
  accent: string;
  onAccent: string;
  line: string;
  display: string;
  body?: string;
}
interface Props {
  slug: string;
  theme: Theme;
  label: string;
}
const { slug, theme, label } = Astro.props;
const vars = [
  `--app-bg:${theme.bg}`,
  `--app-fg:${theme.fg}`,
  `--app-muted:${theme.muted}`,
  `--app-accent:${theme.accent}`,
  `--app-on-accent:${theme.onAccent}`,
  `--app-line:${theme.line}`,
  `--app-display:${theme.display}`,
  `--app-body:${theme.body ?? "'Inter Tight', system-ui, sans-serif"}`,
].join(';');
---

<article class="appview" style={vars} transition:name={`app-${slug}`} data-appview aria-label={label}>
  <nav class="bar">
    <a href="/" class="back" data-home>
      <svg viewBox="0 0 12 20" aria-hidden="true"><path d="M10 2 2 10l8 8" /></svg>
      Home
    </a>
  </nav>
  <div class="body">
    <slot />
  </div>
  <a href="/" class="homebar" aria-label="Back to the home screen" data-home><span></span></a>
</article>

<script>
  import { navigate } from 'astro:transitions/client';

  function goHome() {
    navigate('/', { history: 'push' });
  }

  function init() {
    const view = document.querySelector<HTMLElement>('[data-appview]');
    if (!view) return;

    // Esc (or Backspace outside a field) goes home.
    document.onkeydown = (e) => {
      if (!document.querySelector('[data-appview]')) return;
      const typing = (e.target as HTMLElement).closest('input, textarea, [contenteditable]');
      if (e.key === 'Escape' || (e.key === 'Backspace' && !typing)) {
        e.preventDefault();
        goHome();
      }
    };

    // Pull down from the top to close, on touch screens.
    let startY = 0;
    let dy = 0;
    let pulling = false;
    view.addEventListener(
      'touchstart',
      (e) => {
        if (view.scrollTop > 0) return;
        startY = e.touches[0].clientY;
        dy = 0;
        pulling = true;
        view.style.transition = 'none';
      },
      { passive: true },
    );
    view.addEventListener(
      'touchmove',
      (e) => {
        if (!pulling) return;
        dy = Math.max(0, e.touches[0].clientY - startY);
        if (dy > 0 && view.scrollTop <= 0) {
          const d = dy * 0.55;
          view.style.transform = `translateY(${d}px) scale(${1 - Math.min(d, 260) / 1600})`;
          view.style.borderRadius = `${Math.min(d / 3, 40)}px`;
        }
      },
      { passive: true },
    );
    view.addEventListener('touchend', () => {
      if (!pulling) return;
      pulling = false;
      if (dy > 120) {
        goHome();
        return;
      }
      view.style.transition = 'transform .35s cubic-bezier(.2,.9,.25,1), border-radius .35s';
      view.style.transform = '';
      view.style.borderRadius = '';
    });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .appview {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    background: var(--app-bg);
    color: var(--app-fg);
    font-family: var(--app-body);
    will-change: transform;
  }
  .appview::-webkit-scrollbar {
    display: none;
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 5;
    padding: 56px 20px 10px;
    background: var(--app-bg);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 16px/1 var(--app-body);
    color: var(--app-fg);
    text-decoration: none;
    padding: 6px 4px 6px 0;
  }
  .back svg {
    width: 10px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .body {
    padding: 6px 22px 40px;
  }

  .homebar {
    position: sticky;
    bottom: 0;
    display: flex;
    justify-content: center;
    padding: 14px 0 calc(9px + env(safe-area-inset-bottom));
    background: linear-gradient(to top, var(--app-bg) 60%, transparent);
  }
  .homebar span {
    width: 134px;
    height: 5px;
    border-radius: 3px;
    background: var(--app-fg);
    opacity: 0.85;
  }

  @media (max-width: 767px) {
    .bar {
      padding-top: calc(env(safe-area-inset-top) + 14px);
    }
  }
</style>
