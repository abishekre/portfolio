---
// A cup of coffee on the desk, seen from directly above. Click to take a sip; three sips and it's empty;
// click the empty cup for a refill (an easter egg, counted per day).
---

<div class="coffee" data-coffee>
  <svg class="steam" viewBox="0 0 200 160" aria-hidden="true">
    <defs>
      <filter id="steam-blur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="10"></feGaussianBlur></filter>
    </defs>
    <path d="M78 150 C 58 120, 98 100, 78 70 S 92 30, 80 8" />
    <path d="M112 150 C 132 118, 92 96, 114 64 S 100 24, 116 4" />
    <path d="M96 150 C 104 124, 84 104, 98 76 S 88 40, 98 16" />
  </svg>

  <button class="cup" type="button" data-cup aria-label="A cup of coffee. Take a sip.">
    <svg viewBox="-160 -160 320 320" aria-hidden="true">
      <defs>
        <radialGradient id="cf-saucer" cx="46%" cy="42%" r="58%">
          <stop offset="0" stop-color="#fdfbf7"></stop>
          <stop offset="0.72" stop-color="#f1ebe1"></stop>
          <stop offset="0.93" stop-color="#e2d8c8"></stop>
          <stop offset="1" stop-color="#cfc3b0"></stop>
        </radialGradient>
        <radialGradient id="cf-wall" cx="42%" cy="38%" r="62%">
          <stop offset="0" stop-color="#ffffff"></stop>
          <stop offset="0.8" stop-color="#ece5da"></stop>
          <stop offset="1" stop-color="#d6cbbb"></stop>
        </radialGradient>
        <radialGradient id="cf-coffee" cx="44%" cy="42%" r="56%">
          <stop offset="0" stop-color="#c18a57"></stop>
          <stop offset="0.5" stop-color="#93603a"></stop>
          <stop offset="0.82" stop-color="#5f3a20"></stop>
          <stop offset="1" stop-color="#3a2212"></stop>
        </radialGradient>
        <linearGradient id="cf-steel" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#9c9c98"></stop>
          <stop offset="0.45" stop-color="#f4f4f1"></stop>
          <stop offset="1" stop-color="#b7b7b2"></stop>
        </linearGradient>
        <filter id="cf-shadow" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="9"></feGaussianBlur></filter>
        <filter id="cf-soft" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="1.1"></feGaussianBlur></filter>
        <!-- Stirring smears the latte art; the scale follows how fast you stir. -->
        <filter id="cf-swirl" x="-30%" y="-30%" width="160%" height="160%">
          <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" scale="0" data-swirl></feDisplacementMap>
          <feGaussianBlur stdDeviation="0.9"></feGaussianBlur>
        </filter>
      </defs>

      <!-- An old ring on the desk, from yesterday's cup. -->
      <circle cx="46" cy="64" r="112" fill="none" stroke="#5a3a1c" stroke-opacity="0.1" stroke-width="4" filter="url(#cf-soft)"></circle>

      <!-- Saucer -->
      <circle cx="10" cy="16" r="132" fill="#000" opacity="0.3" filter="url(#cf-shadow)"></circle>
      <circle r="130" fill="url(#cf-saucer)"></circle>
      <circle r="97" fill="none" stroke="#7a6a52" stroke-opacity="0.12" stroke-width="2.5"></circle>

      <!-- Spoon, resting on the saucer; drag around the cup to stir with it -->
      <g class="spoon" data-spoon><g transform="rotate(32)">
        <rect x="-4" y="-124" width="8" height="64" rx="4" fill="url(#cf-steel)" transform="translate(112 52)"></rect>
        <ellipse cx="112" cy="-54" rx="13" ry="19" fill="url(#cf-steel)" transform="translate(0 0)"></ellipse>
        <ellipse cx="110" cy="-56" rx="7" ry="11" fill="#fff" opacity="0.45"></ellipse>
      </g></g>

      <!-- Cup: shadow, handle, rim. Everything in .body lifts together on a sip. -->
      <circle class="cupshadow" cx="7" cy="11" r="84" fill="#000" opacity="0.26" filter="url(#cf-shadow)"></circle>
      <g class="body" data-body>
      <path d="M74 -18 C 112 -22, 118 22, 76 20" fill="none" stroke="#e6ddd0" stroke-width="15" stroke-linecap="round"></path>
      <path d="M74 -18 C 108 -21, 113 19, 76 20" fill="none" stroke="#fbf8f2" stroke-width="10" stroke-linecap="round"></path>
      <circle r="80" fill="#fbf8f2"></circle>
      <circle r="80" fill="none" stroke="#cdbfa9" stroke-width="1.2"></circle>
      <circle r="72.5" fill="url(#cf-wall)"></circle>

      <!-- What's left after the last sip -->
      <circle class="residue" r="44" fill="none" stroke="#6b4426" stroke-width="3" stroke-opacity="0.35" filter="url(#cf-soft)"></circle>

      <!-- Coffee, with a latte heart -->
      <g class="liquid">
        <circle r="67" fill="url(#cf-coffee)"></circle>
        <g class="art" filter="url(#cf-swirl)" data-art>
          <path
            d="M0 34 C -46 6, -50 -34, -20 -40 C -6 -43, 0 -33, 0 -25 C 0 -33, 6 -43, 20 -40 C 50 -34, 46 6, 0 34 Z"
            fill="#e8d2b3"
            transform="translate(0 4) scale(1.12)"></path>
          <path d="M0 28 C -36 6, -40 -26, -16 -32 C -5 -34, 0 -26, 0 -20 C 0 -26, 5 -34, 16 -32 C 40 -26, 36 6, 0 28 Z" fill="#f5e9d6"></path>
          <path d="M0 -24 L 0 36" stroke="#c99a6b" stroke-width="2.2" stroke-linecap="round" opacity="0.7"></path>
        </g>
        <!-- Light on the surface -->
        <ellipse cx="-24" cy="-30" rx="22" ry="9" fill="#fff" opacity="0.08" transform="rotate(-30 -24 -30)"></ellipse>
      </g>

      <!-- A ring that runs across the surface with each sip -->
      <circle class="ripple" r="12" fill="none" stroke="#f1dcc0" stroke-width="2" data-ripple></circle>
      <!-- The pour, on a refill -->
      <path class="pour" d="M-6 -200 C -5 -120, -3 -60, -2 0 L 2 0 C 3 -60, 5 -120, 6 -200 Z" fill="#6e4426" data-pour></path>
      <!-- The spoon while stirring: bowl in the coffee, handle out over the rim. -->
      <g class="stirspoon" data-stirspoon>
        <path d="M30 0 L 118 0" stroke="#c9c9c4" stroke-width="7" stroke-linecap="round"></path>
        <path d="M34 -1.5 L 116 -1.5" stroke="#f2f2ef" stroke-width="2" stroke-linecap="round"></path>
        <ellipse cx="30" cy="0" rx="17" ry="11" fill="url(#cf-steel)"></ellipse>
        <ellipse cx="28" cy="-2" rx="9" ry="5" fill="#fff" opacity="0.4"></ellipse>
      </g>
      <!-- Glaze highlight on the rim -->
      <path d="M -58 -50 A 77 77 0 0 1 26 -72" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity="0.9"></path>
      </g>
    </svg>
  </button>
  <p class="cup-note" data-cup-note aria-live="polite"></p>
</div>

<script>
  import { Spring, calm } from '../lib/spring';
  const ORD = ['', '1st', '2nd', '3rd'];

  function init() {
    const root = document.querySelector<HTMLElement>('[data-coffee]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const cup = root.querySelector<HTMLButtonElement>('[data-cup]')!;
    const note = root.querySelector<HTMLElement>('[data-cup-note]')!;
    const art = root.querySelector<SVGGElement>('[data-art]')!;
    const spoon = root.querySelector<SVGGElement>('[data-spoon]')!;
    const stirSpoon = root.querySelector<SVGGElement>('[data-stirspoon]')!;
    const swirl = root.querySelector<SVGFEDisplacementMapElement>('[data-swirl]')!;
    const ripple = root.querySelector<SVGCircleElement>('[data-ripple]')!;
    const pour = root.querySelector<SVGRectElement>('[data-pour]')!;
    const steam = root.querySelector<SVGSVGElement>('.steam')!;
    let level = 3;
    const show = () => {
      root.dataset.level = String(level);
      cup.setAttribute('aria-label', level ? 'A cup of coffee. Take a sip, or drag to stir.' : 'An empty cup. Refill it.');
    };
    show();

    // Steam leans away from a cursor passing nearby, then drifts back upright.
    const lean = new Spring({ stiffness: 40, damping: 9, onUpdate: (v) => steam.style.setProperty('--lean', v.toFixed(3)) });
    let leanTimer = 0;
    document.addEventListener('pointermove', (e) => {
      if (calm() || e.pointerType !== 'mouse') return;
      const r = cup.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const d = Math.hypot(e.clientX - cx, e.clientY - cy);
      if (d > 260) return;
      lean.to(Math.max(-1, Math.min(1, (cx - e.clientX) / 140)) * (1 - d / 260));
      clearTimeout(leanTimer);
      leanTimer = window.setTimeout(() => lean.to(0), 450);
    });

    // Stirring: drag around the middle of the cup. The spoon follows, the art turns and smears,
    // and both settle once you stop.
    let artAngle = 0;
    let smear = 0;
    let stirring = false;
    let stirred = 0;
    let lastA = 0;
    const turnArt = new Spring({ stiffness: 30, damping: 12, onUpdate: (a) => art.setAttribute('transform', `rotate(${a.toFixed(2)})`) });
    const settle = () => {
      smear *= 0.94;
      swirl.setAttribute('scale', smear.toFixed(2));
      if (smear > 0.2) requestAnimationFrame(settle);
      else swirl.setAttribute('scale', '0');
    };
    const angleAt = (e: PointerEvent) => {
      const r = cup.getBoundingClientRect();
      return (Math.atan2(e.clientY - (r.top + r.height / 2), e.clientX - (r.left + r.width / 2)) * 180) / Math.PI;
    };
    cup.addEventListener('pointerdown', (e) => {
      stirring = true;
      stirred = 0;
      lastA = angleAt(e);
      cup.setPointerCapture(e.pointerId);
    });
    cup.addEventListener('pointermove', (e) => {
      if (!stirring || level === 0 || calm()) return;
      const a = angleAt(e);
      let d = a - lastA;
      if (d > 180) d -= 360;
      if (d < -180) d += 360;
      lastA = a;
      stirred += Math.abs(d);
      if (stirred < 12) return;
      root.classList.add('stirring');
      stirSpoon.setAttribute('transform', `rotate(${a.toFixed(1)})`);
      artAngle += d * 0.7;
      turnArt.to(artAngle);
      const was = smear;
      smear = Math.min(16, smear + Math.abs(d) * 0.12);
      swirl.setAttribute('scale', smear.toFixed(2));
      if (was <= 0.2) requestAnimationFrame(settle);
    });
    const endStir = () => {
      stirring = false;
      root.classList.remove('stirring'); // the spoon goes back on the saucer
    };
    cup.addEventListener('pointerup', endStir);
    cup.addEventListener('pointercancel', endStir);

    // A tap is a sip; three and it's empty; a tap on the empty cup refills it.
    cup.addEventListener('click', () => {
      if (stirred >= 12) {
        stirred = 0;
        return;
      }
      if (level > 0) {
        if (calm()) {
          level--;
          show();
          return;
        }
        // A sip: the cup lifts towards you, then sets down; the coffee slops once and is lower.
        root.classList.remove('sip');
        void root.offsetWidth;
        root.classList.add('sip');
        setTimeout(() => {
          level--;
          show();
          ripple.classList.remove('go');
          void ripple.getBoundingClientRect();
          ripple.classList.add('go');
        }, 380);
        return;
      }
      let n = 2;
      try {
        const today = new Date().toDateString();
        const saved = JSON.parse(localStorage.getItem('pf-cups') ?? '{}');
        n = saved.day === today ? saved.n + 1 : 2;
        localStorage.setItem('pf-cups', JSON.stringify({ day: today, n }));
      } catch {}
      if (!calm()) {
        pour.classList.remove('go');
        void pour.getBoundingClientRect();
        pour.classList.add('go');
        setTimeout(() => {
          ripple.classList.remove('go');
          void ripple.getBoundingClientRect();
          ripple.classList.add('go');
        }, 300);
      }
      root.classList.add('refill');
      setTimeout(
        () => {
          level = 3;
          show();
        },
        calm() ? 0 : 260,
      );
      setTimeout(() => root.classList.remove('refill'), 1400);
      window.__egg?.('coffee');
      note.textContent = n === 2 ? '2nd cup today.' : `${ORD[n] ?? `${n}th`} cup today. Same, honestly.`;
      note.classList.add('show');
      setTimeout(() => note.classList.remove('show'), 3200);
    });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .coffee {
    position: absolute;
    /* Fully on the desk, bottom corner, clear of the ID card. */
    right: 6px;
    bottom: 10px;
    width: 210px;
    height: 210px;
  }
  .cup {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }
  .cup svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .cup:focus-visible {
    outline-offset: -20px;
  }
  .liquid {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.6s cubic-bezier(0.32, 0.72, 0, 1),
      opacity 0.4s ease;
  }
  .art {
    transition: opacity 0.5s ease;
  }
  .residue {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .coffee[data-level='2'] .liquid {
    transform: scale(0.94);
  }
  .coffee[data-level='2'] .art {
    opacity: 0.35;
  }
  .coffee[data-level='1'] .liquid {
    transform: scale(0.86);
  }
  .coffee[data-level='1'] .art {
    opacity: 0;
  }
  .coffee[data-level='0'] .liquid {
    transform: scale(0.6);
    opacity: 0;
  }
  .coffee[data-level='0'] .residue {
    opacity: 1;
  }
  .coffee:global(.refill) .liquid {
    transition-duration: 0.9s;
  }
  .coffee:global(.refill) .art {
    transition-delay: 0.6s;
  }

  /* Seen from above, steam drifts over the cup itself. */
  .steam {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 22px;
    width: 140px;
    height: 140px;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .steam {
    --lean: 0;
  }
  .steam path {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    translate: calc(var(--lean) * -14px) 0;
    rotate: calc(var(--lean) * -14deg);
    fill: none;
    stroke: var(--steam, rgba(255, 255, 255, 0.55));
    stroke-width: 16;
    stroke-linecap: round;
    filter: url(#steam-blur);
    opacity: 0;
    animation: steam 7s ease-in-out infinite;
  }
  .steam path:nth-child(2) {
    animation-delay: 2.6s;
    animation-duration: 8.5s;
  }
  .steam path:nth-child(3) {
    animation-delay: 5.1s;
    animation-duration: 7.5s;
  }
  .coffee[data-level='0'] .steam,
  .coffee[data-level='1'] .steam {
    display: none;
  }
  @keyframes steam {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    35% {
      opacity: 0.3;
    }
    100% {
      opacity: 0;
      transform: translateY(-18px);
    }
  }
  :global(:root[data-time='day']) .steam {
    --steam: rgba(255, 255, 255, 0.7);
  }

  .ripple {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    pointer-events: none;
  }
  .ripple:global(.go) {
    animation: ripple 0.9s cubic-bezier(0.2, 0.6, 0.3, 1);
  }
  @keyframes ripple {
    from {
      opacity: 0.55;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(5.2);
    }
  }
  .pour {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: 50% 0;
    pointer-events: none;
  }
  .pour:global(.go) {
    animation: pour 1.1s ease-in-out;
  }
  @keyframes pour {
    0% {
      opacity: 0.95;
      transform: scaleY(0);
    }
    30% {
      opacity: 0.95;
      transform: scaleY(1);
    }
    75% {
      opacity: 0.95;
      transform: scaleY(1);
    }
    100% {
      opacity: 0;
      transform: scaleY(0.2) translateY(160px);
    }
  }
  .cup {
    touch-action: none;
  }
  /* Hover: it rises a touch, so it's clearly something you can pick up. */
  .cupshadow,
  .body {
    transform-box: view-box;
    transform-origin: 50% 50%;
    transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.35s ease;
  }
  .cup {
    cursor: grab;
  }
  .cup:active {
    cursor: grabbing;
  }
  .cup:hover .body {
    transform: scale(1.012);
  }
  .cup:hover .cupshadow {
    transform: translate(2px, 3px) scale(1.02);
    opacity: 0.85;
  }
  .coffee:global(.sip) .body {
    animation: sip-lift 0.8s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .coffee:global(.sip) .cupshadow {
    animation: sip-shadow 0.8s cubic-bezier(0.32, 0.72, 0, 1);
  }
  @keyframes sip-lift {
    45% {
      transform: scale(1.035) rotate(-2deg);
    }
  }
  @keyframes sip-shadow {
    45% {
      transform: translate(10px, 14px) scale(1.06);
      opacity: 0.55;
    }
  }
  /* Stirring: the spoon leaves the saucer and goes into the cup. */
  .stirspoon {
    opacity: 0;
    transition: opacity 0.15s ease;
    pointer-events: none;
  }
  .coffee:global(.stirring) .stirspoon {
    opacity: 1;
  }
  .coffee:global(.stirring) .spoon {
    opacity: 0;
  }
  .spoon {
    transition: opacity 0.2s ease;
  }
  .cup-note {
    position: absolute;
    left: 150px;
    top: 4px;
    margin: 0;
    padding: 6px 10px;
    background: var(--card);
    border: 1px solid var(--card-line);
    box-shadow: var(--paper-shadow);
    font: italic 400 16px/1.2 var(--serif);
    color: var(--desk-ink);
    white-space: nowrap;
    transform: rotate(-3deg) translateY(6px);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .cup-note:global(.show) {
    opacity: 1;
    transform: rotate(-3deg);
  }

  @media (max-width: 1099px) {
    .coffee {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .steam {
      display: none;
    }
    .liquid,
    .art,
    .residue {
      transition: none;
    }
  }
</style>
