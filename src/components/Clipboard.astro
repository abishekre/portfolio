---
// A legal pad on a clipboard. It persists across pages. Opening an app turns the top page up over
// the clip (it stays folded back there, a lip of paper behind the clip) to show that app's build notes;
// going home brings the page back down. Every line of text sits on the 24px ruling.
import DeskSheet from './DeskSheet.astro';
import type { DeskSheet as Sheet } from '../lib/sheet';
interface Props {
  sheet: Sheet;
}
const { sheet } = Astro.props;
---

<section class="board" data-clipboard aria-label="Notes on the clipboard" aria-live="polite">
  <span class="lip" data-lip aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="clip" aria-hidden="true"><i></i></span>
  <div class="pad" data-pad data-turned="0">
    <span class="edge e2" aria-hidden="true"></span>
    <span class="edge e1" aria-hidden="true"></span>
    <div class="sheet current"><DeskSheet sheet={sheet} /></div>
  </div>
</section>

<script>
  import { calm } from '../lib/spring';

  function turnTo() {
    const board = document.querySelector<HTMLElement>('[data-clipboard]');
    const tpl = document.querySelector<HTMLTemplateElement>('#desk-sheet');
    if (!board || !tpl) return;
    const pad = board.querySelector<HTMLElement>('[data-pad]')!;
    const nextId = tpl.content.querySelector('[data-sheet-id]')?.getAttribute('data-sheet-id');
    const top = pad.querySelector<HTMLElement>('.sheet.current');
    if (!nextId || !top || top.querySelector('[data-sheet-id]')?.getAttribute('data-sheet-id') === nextId) return;

    // Finish anything still moving from a quick earlier navigation.
    pad.querySelectorAll('.sheet:not(.current)').forEach((s) => s.remove());
    pad.querySelectorAll('.sheet').forEach((s) => s.classList.remove('turning-up', 'coming-down', 'revealed'));

    const fresh = top.cloneNode(false) as HTMLElement; // same scoped-style attributes as the top page
    fresh.className = 'sheet current';
    fresh.append(tpl.content.cloneNode(true));

    const back = window.__navDir === 'back';
    const turned = Number(pad.dataset.turned ?? 0);
    pad.dataset.turned = String(Math.max(0, Math.min(3, turned + (back ? -1 : 1))));
    board.dataset.dir = back ? 'back' : 'forward';

    if (calm()) {
      top.replaceWith(fresh);
      return;
    }
    top.classList.remove('current');
    if (!back) {
      // Forward: the new page is underneath; the top page turns up over the clip and stays there.
      pad.insertBefore(fresh, top);
      fresh.classList.add('revealed');
      top.classList.add('turning-up');
      top.addEventListener('animationend', () => top.remove(), { once: true });
    } else {
      // Back: a page comes down from behind the clip, on top of the current one.
      top.after(fresh);
      fresh.classList.add('coming-down');
      fresh.addEventListener(
        'animationend',
        () => {
          fresh.classList.remove('coming-down');
          top.remove();
        },
        { once: true },
      );
    }
  }

  document.addEventListener('astro:after-swap', turnTo);
</script>

<style>
  .board {
    --rule: 24px;
    position: relative;
    width: 300px;
    /* Room for the lamp hanging above it. */
    margin-top: 168px;
    padding: 34px 14px 18px;
    border-radius: 14px;
    /* Hardboard: warm brown with a fine grain. */
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.025) 0 2px, transparent 2px 5px),
      linear-gradient(160deg, #a77b4f, #8d6440);
    box-shadow: var(--paper-shadow);
    transform: rotate(1.2deg);
  }
  .clip {
    position: absolute;
    z-index: 4;
    left: 50%;
    top: -10px;
    width: 116px;
    height: 40px;
    margin-left: -58px;
    border-radius: 8px 8px 12px 12px;
    background: linear-gradient(#e8e8e5, #a6a6a2 60%, #cfcfcb);
    box-shadow:
      0 2px 3px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }
  .clip i {
    position: absolute;
    left: 50%;
    top: 9px;
    width: 42px;
    height: 12px;
    margin-left: -21px;
    border-radius: 6px;
    background: linear-gradient(#8d8d89, #c9c9c5);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.4);
  }

  /* Pages turned up over the clip: their backs show as a lip of paper above it, one per page. */
  .lip {
    position: absolute;
    z-index: 3;
    left: 22px;
    right: 22px;
    top: -2px;
    height: 0;
  }
  .lip i {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 14px;
    border-radius: 3px 3px 0 0;
    background: linear-gradient(#efe9dc, #e2dacb);
    box-shadow: 0 -1px 2px rgba(0, 0, 0, 0.12);
    transform-origin: 50% 100%;
    transform: scaleY(0);
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .lip i:nth-child(2) {
    left: 3px;
    right: 3px;
    bottom: 3px;
  }
  .lip i:nth-child(3) {
    left: 6px;
    right: 6px;
    bottom: 6px;
  }
  .board:has([data-turned='1']) .lip i:nth-child(1),
  .board:has([data-turned='2']) .lip i:nth-child(-n + 2),
  .board:has([data-turned='3']) .lip i {
    transform: scaleY(1);
    transition-delay: 0.42s;
  }

  .pad {
    position: relative;
    display: grid;
    perspective: 1800px;
    perspective-origin: 50% 0;
  }
  /* The rest of the pad, peeking out below the top page. */
  .edge {
    grid-area: 1 / 1;
    background: #f1ece1;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.15);
  }
  .e1 {
    transform: translate(1px, 3px);
  }
  .e2 {
    transform: translate(2px, 6px);
    background: #e6e0d3;
  }

  .sheet {
    grid-area: 1 / 1;
    position: relative;
    /* Fixed, so turning to a longer sheet never moves anything else on the desk. */
    height: calc(var(--rule) * 17);
    overflow: hidden;
    padding: calc(var(--rule) * 1) 16px 0 46px;
    /* Ruled like a legal pad: blue lines on the grid, and a red margin line. */
    background:
      linear-gradient(90deg, transparent 33px, rgba(205, 70, 60, 0.45) 33px 34px, transparent 34px),
      repeating-linear-gradient(to bottom, transparent 0 calc(var(--rule) - 1px), rgba(70, 110, 170, 0.2) calc(var(--rule) - 1px) var(--rule)),
      #fbf9f2;
    background-position: 0 0, 0 calc(var(--rule) * 1);
    color: #221e18;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
    transform-origin: 50% 0;
  }
  /* A page turning up: lifts towards you, passes edge-on, and goes behind the clip. */
  .sheet.turning-up {
    z-index: 2;
    animation: turn-up 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  .sheet.revealed {
    animation: under 0.6s ease-out;
  }
  /* A page coming back down over the pad. */
  .sheet.coming-down {
    z-index: 2;
    animation: come-down 0.6s cubic-bezier(0.3, 0, 0.2, 1) both;
  }
  .sheet.turning-up::after,
  .sheet.coming-down::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.15), rgba(60, 45, 30, 0.3));
    opacity: 0;
    animation: shade 0.6s ease-in-out;
  }
  @keyframes turn-up {
    0% {
      transform: rotateX(0deg);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
    }
    45% {
      box-shadow: 0 36px 36px -18px rgba(0, 0, 0, 0.32);
    }
    100% {
      transform: rotateX(94deg);
      box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    }
  }
  @keyframes come-down {
    0% {
      transform: rotateX(94deg);
    }
    80% {
      transform: rotateX(-2deg);
    }
    100% {
      transform: rotateX(0deg);
    }
  }
  @keyframes under {
    from {
      filter: brightness(0.88);
    }
  }
  @keyframes shade {
    50% {
      opacity: 1;
    }
  }

  /* Everything on the sheet sits on the ruling: each line is one rule (24px) tall. */
  .sheet :global(.sheet-body) {
    font-size: 13px;
    line-height: var(--rule);
  }
  .sheet :global(p),
  .sheet :global(dl),
  .sheet :global(ul) {
    margin: 0;
  }
  .sheet :global(.k) {
    font: 600 12px/var(--rule) var(--sys);
    color: #9a4a1c;
  }
  .sheet :global(.t) {
    /* Two rules tall, with the baseline sitting on the second line. */
    font: 400 36px/calc(var(--rule) * 2) var(--serif);
    height: calc(var(--rule) * 2);
    padding-top: 3px;
  }
  .sheet :global(.s) {
    font-size: 12.5px;
    color: #6f675b;
  }
  .sheet :global(.chips) {
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    column-gap: 5px;
  }
  .sheet :global(.chips li) {
    height: 20px;
    margin: 2px 0;
    padding: 0 8px;
    border: 1px solid #d9d0bf;
    border-radius: 999px;
    background: #fff;
    font-size: 11.5px;
    line-height: 18px;
  }
  .sheet :global(dl div) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .sheet :global(dt) {
    color: #6f675b;
    white-space: nowrap;
  }
  .sheet :global(dd) {
    margin: 0;
    font-weight: 500;
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sheet :global(.links) {
    display: flex;
    flex-wrap: wrap;
    gap: 0 6px;
    padding: 8px 0;
  }
  .sheet :global(.links a) {
    height: 32px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid #cfc5b3;
    background: #fffdf8;
    font: 600 12.5px/30px var(--ui);
    color: #221e18;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }
  .sheet :global(.links a:hover) {
    transform: translateY(-1px);
  }
  .sheet :global(.links a.primary) {
    background: #221e18;
    border-color: #221e18;
    color: #fbf9f2;
  }
  .sheet :global(.f) {
    font-size: 12px;
    color: #8a8072;
  }

  @media (max-width: 1099px) {
    .board {
      width: 100%;
      margin-top: 0;
      transform: none;
    }
    .lip {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet {
      animation: none !important;
    }
  }
</style>
