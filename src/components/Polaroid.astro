---
// A Polaroid of the app being built. The first time it's seen in a visit it develops, from a pale
// cream blank to the full picture over a few seconds; giving it a shake (a click while developing)
// hurries it along, as people do. Once developed, a click turns it over to a handwritten note.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  image: ImageMetadata;
  caption: string;
  back?: string;
  href: string;
  name: string;
}
const { image, caption, back, href, name } = Astro.props;
---

<div class="polaroid" data-polaroid>
  <div class="print" data-print>
    <button class="face front" type="button" data-flip aria-label={`Polaroid of ${name}. Turn it over.`}>
      <span class="tape" aria-hidden="true"></span>
      <span class="photo">
        <Image src={image} alt="" width={360} />
        <span class="emulsion" aria-hidden="true"></span>
      </span>
      <span class="cap">{caption}</span>
    </button>
    <div class="face back" aria-hidden="true" inert>
      <p class="hand">
        {back ?? `${name}, in progress.`}
        <br />
        Building it in the evenings.
      </p>
      <a class="open" href={href}>Open {name} on the phone →</a>
      <button class="turnback" type="button" data-flip>Turn back</button>
    </div>
  </div>
</div>

<script>
  import { calm } from '../lib/spring';

  function init() {
    const root = document.querySelector<HTMLElement>('[data-polaroid]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const print = root.querySelector<HTMLElement>('[data-print]')!;
    const front = root.querySelector<HTMLElement>('.front')!;
    const back = root.querySelector<HTMLElement>('.back')!;

    // Develop once per visit.
    let developing = false;
    let seen = false;
    try {
      seen = sessionStorage.getItem('pf-developed') === '1';
      sessionStorage.setItem('pf-developed', '1');
    } catch {}
    if (!seen && !calm()) {
      developing = true;
      root.classList.add('undeveloped');
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          root.classList.add('developing');
          root.classList.remove('undeveloped');
        }),
      );
      setTimeout(() => {
        developing = false;
        root.classList.remove('developing', 'hurry');
      }, 4200);
    }

    const flip = () => {
      if (developing) {
        // A shake: wiggle, and the picture comes through faster.
        root.classList.remove('shake');
        void root.offsetWidth;
        root.classList.add('shake', 'hurry');
        return;
      }
      const flipped = print.classList.toggle('flipped');
      front.toggleAttribute('inert', flipped);
      back.toggleAttribute('inert', !flipped);
      back.setAttribute('aria-hidden', String(!flipped));
      (flipped ? back.querySelector<HTMLElement>('.turnback') : front)?.focus({ preventScroll: true });
    };
    root.querySelectorAll('[data-flip]').forEach((b) => b.addEventListener('click', flip));
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .polaroid {
    width: 190px;
    transform: rotate(-3deg);
    perspective: 1000px;
  }
  .print {
    display: grid;
    transform-style: preserve-3d;
    /* It turns on its strip of tape, and swings a little as it settles. */
    transform-origin: 50% 0;
    transition: transform 0.8s cubic-bezier(0.34, 1.25, 0.64, 1);
  }
  .print:global(.flipped) {
    transform: rotateY(180deg);
  }
  .face {
    grid-area: 1 / 1;
    position: relative;
    display: block;
    padding: 10px 10px 0;
    border: 0;
    background: #fdfcf9;
    box-shadow: var(--paper-shadow);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    text-align: center;
    color: #2b2620;
  }
  .front {
    cursor: pointer;
  }
  .tape {
    position: absolute;
    left: 50%;
    top: -12px;
    width: 76px;
    height: 24px;
    margin-left: -38px;
    background: rgba(236, 226, 196, 0.72);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.06);
    transform: rotate(-4deg);
  }
  .photo {
    position: relative;
    display: block;
    overflow: hidden;
    background: #1b1916;
  }
  .photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 0;
    filter: saturate(0.92) contrast(1.02);
    transition: filter 4s cubic-bezier(0.2, 0.6, 0.3, 1);
  }
  /* Developing: a milky cream layer thins out while the colour comes up from grey-sepia. */
  .emulsion {
    position: absolute;
    inset: 0;
    background: #e9e3d4;
    opacity: 0;
    transition: opacity 4s cubic-bezier(0.2, 0.6, 0.3, 1);
    pointer-events: none;
  }
  .polaroid:global(.undeveloped) .emulsion {
    opacity: 1;
    transition: none;
  }
  .polaroid:global(.undeveloped) .photo :global(img) {
    filter: saturate(0) sepia(0.6) brightness(1.6) contrast(0.5) blur(1.5px);
    transition: none;
  }
  .polaroid:global(.hurry) .emulsion,
  .polaroid:global(.hurry) .photo :global(img) {
    transition-duration: 1.2s;
  }
  .polaroid:global(.shake) .print {
    animation: shake 0.45s ease-in-out;
  }
  @keyframes shake {
    20% {
      transform: translateX(-5px) rotate(-3deg);
    }
    40% {
      transform: translateX(5px) rotate(3deg);
    }
    60% {
      transform: translateX(-4px) rotate(-2deg);
    }
    80% {
      transform: translateX(3px) rotate(1deg);
    }
  }
  .cap {
    display: block;
    padding: 10px 2px 14px;
    font: 400 19px/1 'Kalam', var(--serif);
    color: #2b2620;
  }
  .back {
    transform: rotateY(180deg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: 18px 16px;
    background:
      repeating-linear-gradient(0deg, transparent 0 3px, rgba(0, 0, 0, 0.012) 3px 4px),
      #f6f3ec;
  }
  .hand {
    margin: 0;
    font: 400 18px/1.35 'Kalam', var(--serif);
    color: #2a3550;
    text-align: left;
    transform: rotate(-1deg);
  }
  .open {
    align-self: flex-start;
    font: 600 13px/1 var(--ui);
    color: #1d1a16;
    text-underline-offset: 3px;
  }
  .turnback {
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    color: #8a8072;
    font: 500 12px/1 var(--ui);
    cursor: pointer;
  }

  @media (max-height: 600px), (max-width: 1099px) {
    .polaroid {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .print {
      transition: none;
    }
  }
</style>
