---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  icon: ImageMetadata;
  size?: number;
  /** Shared-element name; set only where the icon should morph. */
  morph?: string;
}
const { icon, size = 62, morph } = Astro.props;
---

<span class="ic" style={`--s:${size}px`} transition:name={morph}>
  <Image src={icon} alt="" width={size * 2} height={size * 2} loading="eager" />
</span>

<style>
  .ic {
    display: block;
    width: var(--s);
    height: var(--s);
    border-radius: calc(var(--s) * 0.225);
    overflow: hidden;
    flex: none;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.08);
  }
  .ic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
