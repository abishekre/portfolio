---
import { SITE } from '../site';
---

<div class="statusbar" transition:persist="statusbar" aria-hidden="true">
  <span class="sb-time" data-clock>9:41</span>
  <span class="island"></span>
  <span class="sb-right"><span data-temp></span><span class="battery"><i></i></span></span>
</div>

<script define:vars={{ lat: SITE.lat, lon: SITE.lon }}>
  if (!window.__clockStarted) {
    window.__clockStarted = true;
    const fmt = new Intl.DateTimeFormat('en-GB', { hour: 'numeric', minute: '2-digit', hourCycle: 'h12', timeZone: 'Asia/Kolkata' });
    const tick = () => {
      const t = fmt.format(new Date()).replace(/\s?[ap]m/i, '');
      document.querySelectorAll('[data-clock]').forEach((el) => (el.textContent = t));
    };
    tick();
    setInterval(tick, 15000);
    document.addEventListener('astro:page-load', tick);

    const showTemp = (c) => document.querySelectorAll('[data-temp]').forEach((el) => (el.textContent = `${c}°`));
    let cached = null;
    try {
      cached = sessionStorage.getItem('kochi-temp');
    } catch {}
    if (cached) showTemp(cached);
    else
      fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m`)
        .then((r) => r.json())
        .then((d) => {
          const c = Math.round(d.current.temperature_2m);
          showTemp(c);
          try {
            sessionStorage.setItem('kochi-temp', String(c));
          } catch {}
        })
        .catch(() => {});
    document.addEventListener('astro:page-load', () => {
      try {
        const c = sessionStorage.getItem('kochi-temp');
        if (c) showTemp(c);
      } catch {}
    });
  }
</script>

<style>
  .statusbar {
    position: absolute;
    z-index: 20;
    inset: 0 0 auto;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 30px 0 36px;
    font: 600 16px/1 var(--ui);
    color: var(--sb, var(--wall-ink));
    pointer-events: none;
    transition: color 0.3s;
  }
  .island {
    width: 120px;
    height: 34px;
    border-radius: 20px;
    background: #000;
  }
  .sb-right {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    min-width: 54px;
    justify-content: flex-end;
  }
  .battery {
    width: 25px;
    height: 12px;
    border: 1.5px solid currentColor;
    border-radius: 4px;
    padding: 1.5px;
    opacity: 0.9;
  }
  .battery i {
    display: block;
    height: 100%;
    width: 72%;
    background: currentColor;
    border-radius: 1.5px;
  }
  @media (max-width: 767px) {
    .statusbar {
      display: none;
    }
  }
</style>
