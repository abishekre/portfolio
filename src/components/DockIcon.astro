---
// Hand-drawn dock and system icons, so nothing looks like a stock icon set.
interface Props {
  kind: 'resume' | 'mail' | 'github' | 'linkedin' | 'notes' | 'work' | 'wallet' | 'dev';
  size?: number;
}
const { kind, size = 62 } = Astro.props;
---

<span class="ic" style={`--s:${size}px`} aria-hidden="true">
  {
    kind === 'resume' && (
      <svg viewBox="0 0 60 60">
        <rect width="60" height="60" fill="#F6F1E6" />
        <rect x="15" y="10" width="30" height="40" rx="2" fill="#fff" stroke="#211d17" stroke-width="2" />
        <circle cx="24" cy="20" r="4" fill="#211d17" />
        <path d="M31 18h9M31 23h6M20 31h20M20 36h20M20 41h13" stroke="#211d17" stroke-width="2" stroke-linecap="round" />
      </svg>
    )
  }
  {
    kind === 'mail' && (
      <svg viewBox="0 0 60 60">
        <rect width="60" height="60" fill="#211d17" />
        <rect x="12" y="18" width="36" height="25" rx="3" fill="none" stroke="#F6F1E6" stroke-width="2.4" />
        <path d="M13 20l17 13 17-13" fill="none" stroke="#F6F1E6" stroke-width="2.4" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    kind === 'github' && (
      <svg viewBox="0 0 60 60">
        <rect width="60" height="60" fill="#F6F1E6" />
        <g transform="translate(14 14) scale(1.333)">
          <path
            fill="#211d17"
            d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
          />
        </g>
      </svg>
    )
  }
  {
    kind === 'linkedin' && (
      <svg viewBox="0 0 60 60">
        <rect width="60" height="60" fill="#0A66C2" />
        <text x="30" y="40" text-anchor="middle" font-family="Inter Tight, Arial, sans-serif" font-weight="700" font-size="27" fill="#fff">
          in
        </text>
      </svg>
    )
  }
  {
    kind === 'notes' && (
      <svg viewBox="0 0 60 60">
        <rect width="60" height="60" fill="#FBF7EC" />
        <rect width="60" height="17" fill="#EDB54A" />
        <path d="M10 28h40M10 36h40M10 44h28" stroke="#d9cfba" stroke-width="2" />
        <text x="10" y="31" font-family="Instrument Serif, Georgia, serif" font-style="italic" font-size="13" fill="#211d17">
          hi,
        </text>
      </svg>
    )
  }
  {
    kind === 'work' && (
      <svg viewBox="0 0 60 60">
        <rect width="60" height="60" fill="#0B3B6E" />
        <path d="M23 21v-3a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v3" fill="none" stroke="#F6F1E6" stroke-width="2.4" />
        <rect x="12" y="21" width="36" height="24" rx="4" fill="#F6F1E6" />
        <path d="M12 31h36" stroke="#0B3B6E" stroke-width="2" />
        <rect x="27" y="28" width="6" height="6" rx="1.5" fill="#0B3B6E" />
      </svg>
    )
  }
  {
    kind === 'wallet' && (
      <svg viewBox="0 0 60 60">
        <rect width="60" height="60" fill="#111" />
        <rect x="11" y="13" width="38" height="24" rx="4" fill="#E8B04B" />
        <rect x="11" y="19" width="38" height="24" rx="4" fill="#3F7D5A" />
        <rect x="11" y="25" width="38" height="24" rx="4" fill="#2F5FA8" />
        <rect x="11" y="31" width="38" height="18" rx="4" fill="#F6F1E6" />
        <path d="M11 37h38" stroke="#111" stroke-width="1.5" opacity=".25" />
      </svg>
    )
  }
  {
    kind === 'dev' && (
      <svg viewBox="0 0 60 60">
        <rect width="60" height="60" fill="#1F2A24" />
        <path d="M23 21l-9 9 9 9M37 21l9 9-9 9" fill="none" stroke="#8BE3A7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M33 17l-6 26" stroke="#8BE3A7" stroke-width="3" stroke-linecap="round" opacity=".6" />
      </svg>
    )
  }
</span>

<style>
  .ic {
    display: block;
    width: var(--s);
    height: var(--s);
    border-radius: calc(var(--s) * 0.225);
    overflow: hidden;
    flex: none;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.08);
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
