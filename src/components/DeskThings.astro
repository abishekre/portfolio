---
// Small flat drawings that make the desk a desk.
interface Props {
  thing: 'chai' | 'pen';
}
const { thing } = Astro.props;
---

{
  thing === 'chai' && (
    <svg class="chai" viewBox="0 0 96 124" aria-hidden="true">
      <path class="steam" d="M38 22c-5-6 5-9 0-16M52 24c-5-6 5-9 0-16" />
      <path d="M18 30h60l-8 90H26z" class="glass" />
      <path d="M21.4 52h53.2l-6 68H26.9z" fill="#B9773E" />
      <path d="M21.4 52h53.2l-.5 6H21.9z" fill="#D9A66B" />
      <path d="M33 62l1.5 54M43 62l.6 56M53 62l-.6 56M63 62l-1.5 54" class="flute" />
      <path d="M18 30h60l-8 90H26z" class="rim" />
    </svg>
  )
}
{
  thing === 'pen' && (
    <svg class="pen" viewBox="0 0 220 40" aria-hidden="true">
      <g transform="rotate(-14 110 20)">
        <rect x="20" y="15" width="150" height="10" rx="5" class="barrel" />
        <rect x="140" y="13" width="44" height="14" rx="4" class="cap" />
        <rect x="150" y="10" width="3" height="20" rx="1.5" fill="#C9A24A" />
        <path d="M20 15l-14 5 14 5z" fill="#C9A24A" />
      </g>
    </svg>
  )
}

<style>
  .chai {
    width: 72px;
    height: auto;
  }
  .glass {
    fill: color-mix(in oklab, var(--card) 70%, transparent);
  }
  .rim {
    fill: none;
    stroke: var(--desk-ink-3);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .flute {
    stroke: rgba(255, 255, 255, 0.28);
    stroke-width: 1.5;
    fill: none;
  }
  .steam {
    fill: none;
    stroke: var(--desk-ink-3);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .pen {
    width: 170px;
    height: auto;
  }
  .barrel {
    fill: var(--desk-ink);
  }
  .cap {
    fill: color-mix(in oklab, var(--desk-ink) 80%, var(--desk));
  }
  @media (prefers-reduced-motion: no-preference) {
    .steam {
      stroke-dasharray: 4 3;
      animation: rise 2.4s linear infinite;
    }
  }
  @keyframes rise {
    to {
      stroke-dashoffset: 14;
    }
  }
</style>
